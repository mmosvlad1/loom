{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "loom": {
      "source": {
        "source": "github",
        "repo": "mmosvlad1/loom"
      }
    }
  },
  "enabledPlugins": {
    "loom@loom": true
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git stash push *)",
      "Bash(git stash list *)",
      "Bash(git stash show *)",
      "Bash(git stash pop *)",
      "Bash(git branch *)",
      "Bash(make *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh pr list *)",
      "Bash(gh label list *)",
      "Bash(gh repo view *)",
      "Bash(loom-state --json)",
      "Bash(loom-state --json --pr)",
      "Bash(loom-state --slug *)",
      "Bash(mkdir -p .loom/tasks/_archive)",
      "Bash(mv .loom/tasks/* .loom/tasks/_archive/)",
      "Bash(mv .loom/tasks/_archive/* .loom/tasks/)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh label create *)",
      "Bash(gh api *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/loom-statusline.py\" 2>/dev/null"
  }
}
