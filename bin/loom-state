#!/usr/bin/env python3
"""loom-state: compute the state of the current loom task.

This is the single source of truth for "where is the task and what comes
next" (LOOM_SPEC.md section 8). It is used by the SessionStart hook,
/loom:next, the phase skills, and the statusline.

Usage: loom-state [--json | --line] [--pr] [--docs]
       loom-state --slug '<issue title>'
       loom-state --setup-path <main>

The script is a silent no-op (exit 0, no output) outside a git repository and
in a repository without .claude/loom.json. `--slug` works anywhere;
`--setup-path` works in any git repository (exit 2 outside one). Standard
library only; it runs on Python 3.9.
"""
from __future__ import annotations

import argparse
import copy
import datetime
import fnmatch
import json
import os
import posixpath
import re
import shlex
import subprocess
import sys
import unicodedata
from typing import Any, Dict, List, Optional, Set, Tuple

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

CONFIG_PATH = os.path.join(".claude", "loom.json")

DEFAULT_CONFIG: Dict[str, Any] = {
    "version": 1,
    "tracker": "github",
    "mainBranch": "main",
    "workDir": ".loom/tasks",
    "docsDir": "docs",
    "checks": {
        "lint": "make lint",
        "typecheck": "make typecheck",
        "test": "make test",
        "check": "make check",
    },
    "hooks": {"stopLint": False, "maxCheckAttempts": 3},
    "rounds": {"cap": {"S": 2, "M": 3, "L": 5}},
    "implement": {"maxFixAttempts": 2, "autoAdvance": True},
}

# Check commands that may be null: the project has no such check (LOOM_SPEC.md 19.1).
OPTIONAL_CHECKS = ("lint", "typecheck", "test")
CHECK_KEYS = OPTIONAL_CHECKS + ("check",)

# Optional keys with defaults outside DEFAULT_CONFIG (the loom.json template does
# not list them). The docs map defaults lie below docsDir (LOOM_SPEC.md 15).
DOCS_FILE_ROLES = {
    "vision": "product/vision.md",
    "overview": "architecture/overview.md",
    "conventions": "conventions.md",
}
DOCS_DIR_ROLES = {"tasks": "tasks"}
DOCS_ROLES = ("vision", "overview", "decisions", "conventions", "tasks")
DEFAULT_DECISIONS_DIR = "architecture/decisions"
DEFAULT_DECISIONS_PATTERN = "<NNNN>-<slug>.md"
DEFAULT_CI: Dict[str, Any] = {"requiredCheck": "check"}
DEFAULT_PULL_REQUEST: Dict[str, Any] = {"requiredSections": []}

# Numeric and boolean settings (LOOM_SPEC.md 19.1): "positive" is an integer
# >= 1, "count" an integer >= 0, "bool" true or false. A JSON boolean is never
# a number here. Defaults come from DEFAULT_CONFIG.
SETTINGS_SCHEMA: Dict[str, Any] = {
    "rounds": {"cap": {"S": "positive", "M": "positive", "L": "positive"}},
    "implement": {"maxFixAttempts": "count", "autoAdvance": "bool"},
    "hooks": {"stopLint": "bool", "maxCheckAttempts": "positive"},
}
SETTING_RULES = {
    "positive": "an integer of at least 1",
    "count": "an integer of at least 0",
    "bool": "true or false",
}

# Commands that filter output: a check piped into one of them can hide failures.
# The PreToolUse hook block_output_filtering.py denies the same filters.
OUTPUT_FILTERS = ("head", "tail", "grep", "egrep", "fgrep", "sed", "awk", "gawk", "nawk", "cut",
                  "less", "more", "rg", "wc")

BRANCH_RE = re.compile(r"^(feat|fix|chore|docs|refactor)/([0-9]+)-(.+)$")

# The setup task (LOOM_SPEC.md 9.13.1): its branch, and the slug only it may use.
SETUP_SLUG = "loom-setup"
SETUP_SLUG_REPLACEMENT = "loom-setup-task"
SETUP_BRANCH_RE = re.compile(r"^chore/([0-9]+)-%s$" % SETUP_SLUG)
# .claude/loom.json as git names it (CONFIG_PATH uses the OS separator).
CONFIG_FILE = ".claude/loom.json"

TICKET_FILE = "00-ticket.md"
LOG_FILE = "log.md"
EVENTS_FILE = "events.jsonl"
PLAN_FILE = "04-plan.md"
RESEARCH_FILE = "02-research.md"
ARCHIVE_DIR = "_archive"
LOOM_DIR = ".loom"

# Artifact files in phase order (the ticket and log.md are handled separately).
ARTIFACT_FILES: List[Tuple[str, str]] = [
    ("01-research-questions.md", "research-questions"),
    ("02-research.md", "research"),
    ("03-design.md", "design"),
    ("04-plan.md", "plan"),
]
PHASE_FILE = {phase: name for name, phase in ARTIFACT_FILES}

MODES = ("oneshot", "quick", "full")
SIZES = ("S", "M", "L")

# Artifact-producing phases per mode, in order (implement follows them).
ARTIFACT_STATUSES = ("draft", "in-review", "approved")

PHASES_BY_MODE: Dict[str, List[str]] = {
    "oneshot": [],
    "quick": ["research", "plan"],
    "full": ["research-questions", "research", "design", "plan"],
}

# Gate artifacts per mode (LOOM_SPEC.md section 13.1).
GATES_BY_MODE: Dict[str, List[str]] = {
    "oneshot": [],
    "quick": ["plan"],
    "full": ["design", "plan"],
}

PHASE_COMMAND = {
    "research-questions": "/loom:research-questions",
    "research": "/loom:research",
    "design": "/loom:design",
    "plan": "/loom:plan",
}

REVIEWED_STATUSES = ("in-review", "approved")

GIT_TIMEOUT = 10
GH_TIMEOUT = 20

# A segment `duration_s` above this (one week) is not a real subagent run.
MAX_SEGMENT_SECONDS = 7 * 24 * 3600

# ---------------------------------------------------------------------------
# Subprocess helpers
# ---------------------------------------------------------------------------


def _env() -> Dict[str, str]:
    env = dict(os.environ)
    # Never take the index lock from a status query (statusline, hooks).
    env["GIT_OPTIONAL_LOCKS"] = "0"
    env.setdefault("LC_ALL", "C")
    return env


def run(
    args: List[str], cwd: str, timeout: int = GIT_TIMEOUT, extra_env: Optional[Dict[str, str]] = None
) -> Tuple[int, str, str]:
    """Run a command and return (returncode, stdout, stderr). Never raises."""
    env = _env()
    if extra_env:
        env.update(extra_env)
    try:
        proc = subprocess.run(
            args,
            cwd=cwd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            env=env,
        )
    except FileNotFoundError:
        return 127, "", "%s: command not found" % args[0]
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        # ValueError: an argument with a NUL byte or a character that cannot be encoded.
        return 1, "", str(exc)
    out = proc.stdout.decode("utf-8", "replace")
    err = proc.stderr.decode("utf-8", "replace")
    return proc.returncode, out, err


def git(
    args: List[str], cwd: str, timeout: int = GIT_TIMEOUT, extra_env: Optional[Dict[str, str]] = None
) -> Tuple[int, str, str]:
    return run(["git"] + args, cwd, timeout, extra_env)


def non_interactive_env(cwd: str) -> Dict[str, str]:
    """Environment for network git calls: fail instead of prompting.

    Keeps the user's SSH setup: an existing GIT_SSH_COMMAND gets
    `-oBatchMode=yes` appended; with core.sshCommand set, SSH is left alone.
    """
    env = {"GIT_TERMINAL_PROMPT": "0"}
    current = os.environ.get("GIT_SSH_COMMAND")
    if current:
        env["GIT_SSH_COMMAND"] = current + " -oBatchMode=yes"
    elif not git_out(["config", "--get", "core.sshCommand"], cwd):
        env["GIT_SSH_COMMAND"] = "ssh -oBatchMode=yes"
    return env


def git_out(args: List[str], cwd: str) -> Optional[str]:
    """Return stripped stdout of a git command, or None on failure."""
    rc, out, _ = git(args, cwd)
    if rc != 0:
        return None
    return out.strip()


# ---------------------------------------------------------------------------
# Repository and configuration
# ---------------------------------------------------------------------------


def find_toplevel(cwd: str) -> Optional[str]:
    if not cwd or not os.path.isdir(cwd):
        return None
    top = git_out(["rev-parse", "--show-toplevel"], cwd)
    return top or None


def _deep_merge(base: Dict[str, Any], override: Dict[str, Any]) -> Dict[str, Any]:
    result = copy.deepcopy(base)
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = _deep_merge(result[key], value)
        else:
            result[key] = value
    return result


def config_path(top: str) -> str:
    return os.path.join(top, CONFIG_PATH)


def load_config(top: str) -> Tuple[Optional[Dict[str, Any]], List[str]]:
    """Return (config with defaults, warnings), or (None, []) without loom.json."""
    path = config_path(top)
    if not os.path.isfile(path):
        return None, []
    warnings: List[str] = []
    data: Any = {}
    try:
        # utf-8-sig: a byte order mark (some Windows editors write one) is not JSON.
        with open(path, "r", encoding="utf-8-sig") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as exc:
        warnings.append("cannot read %s (%s); using defaults" % (CONFIG_PATH, exc))
        data = {}
    if not isinstance(data, dict):
        warnings.append("%s is not a JSON object; using defaults" % CONFIG_PATH)
        data = {}
    for key in data:
        if key not in CONFIG_KEYS:
            warnings.append("%s: unknown key '%s' ignored" % (CONFIG_PATH, key))
    cfg = _deep_merge(DEFAULT_CONFIG, data)
    main_branch = cfg.get("mainBranch")
    if isinstance(main_branch, str) and main_branch.strip() and not _has_control(main_branch.strip()):
        cfg["mainBranch"] = main_branch.strip()
    else:
        warnings.append(_invalid("mainBranch", main_branch, DEFAULT_CONFIG["mainBranch"]))
        cfg["mainBranch"] = DEFAULT_CONFIG["mainBranch"]
    # workDir first: docsDir and the docs map may not lie at or below it.
    work_dir = _clean_path(cfg.get("workDir"), None, WORK_DIR_RESERVED)
    if work_dir is None:
        warnings.append(_invalid("workDir", cfg.get("workDir"), DEFAULT_CONFIG["workDir"]))
        work_dir = DEFAULT_CONFIG["workDir"]
    cfg["workDir"] = work_dir
    docs_dir = _clean_path(cfg.get("docsDir"), work_dir)
    if docs_dir is None:
        warnings.append(_invalid("docsDir", cfg.get("docsDir"), DEFAULT_CONFIG["docsDir"]))
        docs_dir = DEFAULT_CONFIG["docsDir"]
    cfg["docsDir"] = docs_dir
    if not isinstance(cfg.get("checks"), dict):
        warnings.append("%s: invalid 'checks'; using defaults" % CONFIG_PATH)
        cfg["checks"] = copy.deepcopy(DEFAULT_CONFIG["checks"])
    warnings.extend(_resolve_checks(cfg["checks"]))
    cfg["docs"], w = resolve_docs(data.get("docs", MISSING), cfg["docsDir"], cfg["workDir"])
    warnings.extend(w)
    cfg["ci"], w = resolve_ci(data.get("ci", MISSING))
    warnings.extend(w)
    cfg["pullRequest"], w = resolve_pull_request(data.get("pullRequest", MISSING))
    warnings.extend(w)
    for key, schema in SETTINGS_SCHEMA.items():
        cfg[key], w = resolve_settings(key, data.get(key, MISSING), schema, DEFAULT_CONFIG[key])
        warnings.extend(w)
    # A lone surrogate from a JSON escape cannot be printed: escape it.
    return cfg, [_printable(w) for w in warnings]


def _printable(text: str) -> str:
    return text.encode("utf-8", "backslashreplace").decode("utf-8")


# Top-level loom.json keys (LOOM_SPEC.md 19.1); any other key gets a warning.
CONFIG_KEYS = ("version", "tracker", "mainBranch", "workDir", "docsDir", "docs", "checks", "ci",
               "pullRequest", "hooks", "rounds", "implement")

# A key that loom.json does not have (unlike null, which is an invalid value).
MISSING: Any = object()


def _has_control(text: str) -> bool:
    """True if text has a control character (newline, tab, NUL, ...) or a lone surrogate."""
    return any(unicodedata.category(ch) in ("Cc", "Cs") for ch in text)


def _setting_ok(rule: str, value: Any) -> bool:
    if rule == "bool":
        return isinstance(value, bool)
    if isinstance(value, bool) or not isinstance(value, int):
        return False
    return value >= (1 if rule == "positive" else 0)


def resolve_settings(
    key: str, raw: Any, schema: Dict[str, Any], defaults: Dict[str, Any]
) -> Tuple[Dict[str, Any], List[str]]:
    """Resolve a settings object of SETTINGS_SCHEMA (`rounds`, `implement`, `hooks`).

    A missing field takes its default; an invalid value gets a warning and its
    default; an unknown field gets a warning and is ignored.
    """
    resolved = copy.deepcopy(defaults)
    warnings: List[str] = []
    if raw is MISSING:
        return resolved, warnings
    if not isinstance(raw, dict):
        warnings.append(_invalid(key, raw, defaults))
        return resolved, warnings
    for name in raw:
        if name not in schema:
            warnings.append("%s: unknown key '%s.%s' ignored" % (CONFIG_PATH, key, name))
    for name, rule in schema.items():
        if name not in raw:
            continue
        path = "%s.%s" % (key, name)
        if isinstance(rule, dict):
            resolved[name], w = resolve_settings(path, raw[name], rule, defaults[name])
            warnings.extend(w)
        elif _setting_ok(rule, raw[name]):
            resolved[name] = raw[name]
        else:
            warnings.append("%s (%s)" % (_invalid(path, raw[name], defaults[name]), SETTING_RULES[rule]))
    return resolved, warnings


def _invalid(key: str, value: Any, default: Any) -> str:
    return "%s: invalid %r (%s); using the default %s" % (
        CONFIG_PATH, key, json.dumps(value, ensure_ascii=False), json.dumps(default, ensure_ascii=False))


def _resolve_checks(checks: Dict[str, Any]) -> List[str]:
    """Validate the check commands in place (LOOM_SPEC.md 19.1).

    `lint`, `typecheck`, and `test` are a command or null (no such check); an
    empty string is null with a warning (it turned the check off in 1.1.0).
    `check` is always a command. Another invalid value takes its default.
    """
    warnings: List[str] = []
    for key in CHECK_KEYS:
        value = checks.get(key)
        if value is None and key in OPTIONAL_CHECKS:
            continue
        if isinstance(value, str) and value.strip():
            continue
        if isinstance(value, str) and key in OPTIONAL_CHECKS:
            warnings.append("%s: empty 'checks.%s' means no such check; use null" % (CONFIG_PATH, key))
            checks[key] = None
            continue
        default = DEFAULT_CONFIG["checks"][key]
        warnings.append(_invalid("checks." + key, value, default))
        checks[key] = default
    for key in CHECK_KEYS:
        value = checks.get(key)
        output_filter = piped_filter(value) if isinstance(value, str) else None
        if output_filter:
            # The command stays as configured; the hook allows it verbatim (LOOM_SPEC.md 11.3).
            warnings.append("%s: 'checks.%s' pipes its output into %s; filtered output can hide failures"
                            % (CONFIG_PATH, key, output_filter))
    return warnings


def piped_filter(command: str) -> Optional[str]:
    """The first OUTPUT_FILTERS command that a pipe in `command` feeds, or None.

    A light shell split: `|` and `|&` start a pipe stage; variable
    assignments before the stage's command are skipped. Unparsable text
    (an open quote) gives None.
    """
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
        lexer.whitespace_split = True
        tokens = list(lexer)
    except ValueError:
        return None
    after_pipe = False
    for token in tokens:
        if token in ("|", "|&"):
            after_pipe = True
            continue
        if not after_pipe:
            continue
        if _ASSIGNMENT_RE.match(token):
            continue
        name = posixpath.basename(token)
        if name in OUTPUT_FILTERS:
            return name
        after_pipe = False
    return None


_ASSIGNMENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")


# Directories that never hold a document of the docs map: git, Claude Code, and loom's working area.
RESERVED_DIRS = (".git", ".claude", LOOM_DIR)
# workDir may lie below .loom/ (its default is .loom/tasks).
WORK_DIR_RESERVED = (".git", ".claude")


def _clean_path(value: Any, work_dir: Optional[str], reserved_dirs: Tuple[str, ...] = RESERVED_DIRS) -> Optional[str]:
    """A configured path (docsDir, workDir, a docs map path), normalized; None if invalid.

    Valid: a non-empty relative path without control characters, not `.`
    (the git top level), without a `..` segment, and not at or below workDir
    or a reserved directory (`.git/`, `.claude/`, `.loom/`). The reserved
    directories and workDir compare case-insensitively (macOS and Windows
    file systems ignore case). Surrounding whitespace is stripped.
    """
    if not isinstance(value, str) or not value.strip() or _has_control(value.strip()):
        return None
    text = value.strip()
    if text.startswith("/") or text.startswith("\\") or os.path.isabs(text) or ".." in text.split("/"):
        return None
    path = posixpath.normpath(text)
    if path == ".":
        return None
    if work_dir is not None and _is_under_ignoring_case(path, posixpath.normpath(work_dir)):
        return None
    if any(_is_under_ignoring_case(path, reserved) for reserved in reserved_dirs):
        return None
    return path


def _is_under_ignoring_case(path: str, prefix: str) -> bool:
    return _is_under(path.lower(), prefix.lower())


def _is_markdown(path: str) -> bool:
    return path.lower().endswith(".md")


_NUMBER_PLACEHOLDER_RE = re.compile(r"<(N+)>")


def valid_decisions_pattern(value: Any) -> bool:
    """A file name (no `/`) ending in `.md`, with `<slug>` once and one `<N…N>` of 1-6 N."""
    if not isinstance(value, str) or "/" in value or not _is_markdown(value) or _has_control(value):
        return False
    numbers = _NUMBER_PLACEHOLDER_RE.findall(value)
    return value.count("<slug>") == 1 and len(numbers) == 1 and 1 <= len(numbers[0]) <= 6


def default_docs(docs_dir: str) -> Dict[str, Any]:
    """The docs map with every role at its default path below docsDir."""
    base = posixpath.normpath(docs_dir.strip())

    def below(rel: str) -> str:
        return posixpath.normpath(posixpath.join(base, rel))

    return {
        "dir": base,
        "vision": below(DOCS_FILE_ROLES["vision"]),
        "overview": below(DOCS_FILE_ROLES["overview"]),
        "decisions": {"dir": below(DEFAULT_DECISIONS_DIR), "pattern": DEFAULT_DECISIONS_PATTERN},
        "conventions": below(DOCS_FILE_ROLES["conventions"]),
        "tasks": below(DOCS_DIR_ROLES["tasks"]),
    }


def resolve_docs(raw: Any, docs_dir: str, work_dir: str) -> Tuple[Dict[str, Any], List[str]]:
    """Resolve loom.json `docs` (the docs map) against the defaults (LOOM_SPEC.md 15, 19.1).

    Returns ({dir, vision, overview, decisions: {dir, pattern}, conventions,
    tasks}, warnings). `dir` is docsDir. Paths are relative to the git top
    level. An invalid value gets a warning and its default. raw is MISSING
    when loom.json has no `docs` key (null is not an object). The resolved
    map, defaults included, is then checked for overlaps.
    """
    docs, warnings = _resolve_docs_values(raw, docs_dir, work_dir)
    warnings.extend(docs_overlaps(docs))
    warnings.extend(docs_in_work_dir(docs, work_dir))
    return docs, warnings


def _resolve_docs_values(raw: Any, docs_dir: str, work_dir: str) -> Tuple[Dict[str, Any], List[str]]:
    docs = default_docs(docs_dir)
    warnings: List[str] = []
    if raw is MISSING:
        return docs, warnings
    if not isinstance(raw, dict):
        warnings.append("%s: 'docs' is not an object; using the default docs map" % CONFIG_PATH)
        return docs, warnings
    for key in raw:
        if key not in DOCS_ROLES:
            warnings.append("%s: unknown key 'docs.%s' ignored" % (CONFIG_PATH, key))
    for role in list(DOCS_FILE_ROLES) + list(DOCS_DIR_ROLES):
        if role not in raw:
            continue
        path = _clean_path(raw[role], work_dir)
        if path is None or (role in DOCS_FILE_ROLES and not _is_markdown(path)):
            warnings.append(_invalid("docs." + role, raw[role], docs[role]))
        else:
            docs[role] = path
    decisions = raw.get("decisions", MISSING)
    if decisions is not MISSING and not isinstance(decisions, dict):
        warnings.append(_invalid("docs.decisions", decisions, docs["decisions"]))
    elif decisions is not MISSING:
        for key in decisions:
            if key not in ("dir", "pattern"):
                warnings.append("%s: unknown key 'docs.decisions.%s' ignored" % (CONFIG_PATH, key))
        if "dir" in decisions:
            path = _clean_path(decisions["dir"], work_dir)
            if path is None:
                warnings.append(_invalid("docs.decisions.dir", decisions["dir"], docs["decisions"]["dir"]))
            else:
                docs["decisions"]["dir"] = path
        if "pattern" in decisions:
            if valid_decisions_pattern(decisions["pattern"]):
                docs["decisions"]["pattern"] = decisions["pattern"]
            else:
                warnings.append(_invalid("docs.decisions.pattern", decisions["pattern"], DEFAULT_DECISIONS_PATTERN))
    return docs, warnings


def docs_in_work_dir(docs: Dict[str, Any], work_dir: str) -> List[str]:
    """Warnings for resolved docs map paths at or below workDir; the values stay.

    A configured path there is already invalid, so only a default built from
    docsDir can land there (docsDir `work`, workDir `work/tasks`: docs.tasks
    is `work/tasks`). Its default is the only default, so it stays.
    """
    warnings: List[str] = []
    roles = [("docs." + role, docs[role]) for role in list(DOCS_FILE_ROLES) + list(DOCS_DIR_ROLES)]
    roles.append(("docs.decisions.dir", docs["decisions"]["dir"]))
    for key, path in roles:
        if _is_under_ignoring_case(path, posixpath.normpath(work_dir)):
            warnings.append("%s: '%s' (%s) is at or below workDir (%s), where loom ignores changes; "
                            "set '%s' or docsDir to a path outside workDir" % (CONFIG_PATH, key, path, work_dir, key))
    return warnings


def docs_overlaps(docs: Dict[str, Any]) -> List[str]:
    """Warnings for docs map roles that collide (LOOM_SPEC.md 19.1); the values stay.

    vision, overview, and conventions may share one file. docs.tasks and
    docs.decisions.dir must not be at or below each other, and no role file
    may lie at or below either directory.
    """
    warnings: List[str] = []
    dirs = (("docs.tasks", docs["tasks"]), ("docs.decisions.dir", docs["decisions"]["dir"]))
    (tasks_key, tasks), (decisions_key, decisions) = dirs
    if _is_under_ignoring_case(tasks, decisions) or _is_under_ignoring_case(decisions, tasks):
        warnings.append("%s: '%s' (%s) and '%s' (%s) overlap; task summaries and decision records would mix"
                        % (CONFIG_PATH, tasks_key, tasks, decisions_key, decisions))
    for role in DOCS_FILE_ROLES:
        for dir_key, directory in dirs:
            if _is_under_ignoring_case(docs[role], directory):
                warnings.append("%s: 'docs.%s' (%s) is at or below '%s' (%s); keep role files outside the "
                                "task summary and decision directories"
                                % (CONFIG_PATH, role, docs[role], dir_key, directory))
    return warnings


def resolve_ci(raw: Any) -> Tuple[Dict[str, Any], List[str]]:
    """Resolve loom.json `ci`: `requiredCheck` is the CI check that runs checks.check."""
    ci = copy.deepcopy(DEFAULT_CI)
    warnings: List[str] = []
    if raw is MISSING:
        return ci, warnings
    if not isinstance(raw, dict):
        warnings.append(_invalid("ci", raw, ci))
        return ci, warnings
    for key in raw:
        if key not in ci:
            warnings.append("%s: unknown key 'ci.%s' ignored" % (CONFIG_PATH, key))
    if "requiredCheck" in raw:
        value = raw["requiredCheck"]
        if isinstance(value, str) and value.strip() and not _has_control(value.strip()):
            ci["requiredCheck"] = value.strip()
        else:
            warnings.append(_invalid("ci.requiredCheck", value, DEFAULT_CI["requiredCheck"]))
    return ci, warnings


_REQUIRED_SECTION_RE = re.compile(r"^#{2,3} +\S[^\r\n]*$")


def resolve_pull_request(raw: Any) -> Tuple[Dict[str, Any], List[str]]:
    """Resolve loom.json `pullRequest`: `requiredSections` lists `## <text>` or `### <text>` headings.

    An invalid item, or a repeated one, is dropped with a warning.
    """
    pull_request = copy.deepcopy(DEFAULT_PULL_REQUEST)
    warnings: List[str] = []
    if raw is MISSING:
        return pull_request, warnings
    if not isinstance(raw, dict):
        warnings.append(_invalid("pullRequest", raw, pull_request))
        return pull_request, warnings
    for key in raw:
        if key not in pull_request:
            warnings.append("%s: unknown key 'pullRequest.%s' ignored" % (CONFIG_PATH, key))
    if "requiredSections" not in raw:
        return pull_request, warnings
    sections = raw["requiredSections"]
    if not isinstance(sections, list):
        warnings.append(_invalid("pullRequest.requiredSections", sections, []))
        return pull_request, warnings
    for item in sections:
        heading = item.strip() if isinstance(item, str) else None
        if heading is None or not _REQUIRED_SECTION_RE.match(heading) or _has_control(heading):
            warnings.append("%s: invalid item %s in 'pullRequest.requiredSections' dropped (a heading "
                            "`## <text>` or `### <text>`)" % (CONFIG_PATH, json.dumps(item, ensure_ascii=False)))
        elif heading in pull_request["requiredSections"]:
            warnings.append("%s: repeated item %s in 'pullRequest.requiredSections' dropped"
                            % (CONFIG_PATH, json.dumps(item, ensure_ascii=False)))
        else:
            pull_request["requiredSections"].append(heading)
    return pull_request, warnings


def docs_change_paths(cfg: Dict[str, Any]) -> List[str]:
    """Paths whose changes count as docs changes: docsDir and every path of the docs map.

    Used by `workingTreeDocsOnly` and the Stop hook (LOOM_SPEC.md 8.2, 11.5).
    """
    docs = cfg.get("docs") or default_docs(cfg["docsDir"])
    paths = [cfg["docsDir"], docs["dir"], docs["decisions"]["dir"]]
    paths += [docs[role] for role in list(DOCS_FILE_ROLES) + list(DOCS_DIR_ROLES)]
    unique: List[str] = []
    for path in paths:
        if path not in unique:
            unique.append(path)
    return unique


def load_repo_config(cwd: str) -> Tuple[Optional[str], Optional[Dict[str, Any]]]:
    """Return (toplevel, config) for cwd, or (None, None) if loom does not apply."""
    top = find_toplevel(cwd)
    if not top:
        return None, None
    cfg, _ = load_config(top)
    if cfg is None:
        return None, None
    return top, cfg


def work_dir_abs(top: str, cfg: Dict[str, Any]) -> str:
    return os.path.normpath(os.path.join(top, cfg["workDir"]))


def rel_to(top: str, path: str) -> str:
    try:
        rel = os.path.relpath(path, top)
    except ValueError:
        return path
    if rel.startswith(".."):
        return path
    return rel.replace(os.sep, "/")


def current_branch(cwd: str) -> Optional[str]:
    """Current branch name (works on an unborn branch); None on detached HEAD."""
    return git_out(["symbolic-ref", "--quiet", "--short", "HEAD"], cwd) or None


def rebase_branch(cwd: str) -> Optional[str]:
    """The branch that a stopped `git rebase` rewrites, or None without a rebase.

    Reads `head-name` of rebase-merge/ (merge backend) or rebase-apply/
    (apply backend) in the git directory of this worktree.
    """
    out = git_out(["rev-parse", "--git-path", "rebase-merge/head-name",
                   "--git-path", "rebase-apply/head-name"], cwd)
    for line in (out or "").splitlines():
        text = read_text(os.path.join(cwd, line.strip()))
        if text is None:
            continue
        name = text.strip()
        if name.startswith("refs/heads/"):
            return name[len("refs/heads/"):] or None
    return None


def task_branch(cwd: str) -> Tuple[Optional[str], bool]:
    """(branch, rebase in progress). During a rebase HEAD is detached, and the
    branch is the one being rebased; a plain detached HEAD gives (None, False)."""
    branch = current_branch(cwd)
    if branch:
        return branch, False
    rebasing = rebase_branch(cwd)
    return (rebasing, True) if rebasing else (None, False)


# ---------------------------------------------------------------------------
# Markdown parsing
# ---------------------------------------------------------------------------


def _strip_inline_comment(value: str) -> str:
    quote = None
    for i, ch in enumerate(value):
        if quote:
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
        elif ch == "#" and (i == 0 or value[i - 1] in " \t"):
            if i == 0 and value[1:2].isdigit() and value[1:2].isascii():
                continue  # `pr: #57`: a number written the way skills write PR numbers
            return value[:i].rstrip()
    return value


def _unquote(value: str) -> str:
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def _parse_scalar(value: str) -> Any:
    value = value.strip()
    if value in ("", "~", "null", "Null", "NULL"):
        return None
    return _unquote(value)


def _split_inline_list(inner: str) -> List[str]:
    items: List[str] = []
    buf: List[str] = []
    quote = None
    for ch in inner:
        if quote:
            buf.append(ch)
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
            buf.append(ch)
        elif ch == ",":
            items.append("".join(buf))
            buf = []
        else:
            buf.append(ch)
    items.append("".join(buf))
    return [_unquote(item.strip()) for item in items if item.strip()]


def split_frontmatter(text: str) -> Tuple[Dict[str, Any], str]:
    """Split a markdown file into (frontmatter dict, body).

    Supports the fields of LOOM_SPEC.md section 13.1: `key: scalar` and
    `key: [a, b]` inline lists, with optional quotes and trailing `# comments`.
    Values stay strings (or lists of strings, or None); callers convert.
    """
    if text.startswith("﻿"):
        text = text[1:]
    lines = text.splitlines(True)
    if not lines or lines[0].strip() != "---":
        return {}, text
    end = None
    for i in range(1, len(lines)):
        if lines[i].strip() in ("---", "..."):
            end = i
            break
    if end is None:
        return {}, text
    data: Dict[str, Any] = {}
    for raw in lines[1:end]:
        line = raw.rstrip("\r\n")
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line[0] in " \t" or ":" not in line:
            continue  # nested structures are not used by loom
        key, _, value = line.partition(":")
        key = key.strip()
        value = _strip_inline_comment(value.strip())
        if value.startswith("[") and value.endswith("]"):
            data[key] = _split_inline_list(value[1:-1])
        else:
            data[key] = _parse_scalar(value)
    return data, "".join(lines[end + 1:])


def parse_frontmatter(text: str) -> Dict[str, Any]:
    return split_frontmatter(text)[0]


# Fenced code blocks, following CommonMark's fence rules except for indentation:
# a run of 3+ backticks or tildes opens a fence (a backtick info string may not
# contain backticks). Only a run of the same character, at least as long, with
# nothing but whitespace after it, closes the fence. Unlike CommonMark, any
# leading whitespace is accepted (CommonMark allows at most 3 spaces), so fences
# inside nested list items are recognized too.
_FENCE_OPEN_RE = re.compile(r"^\s*(`{3,}(?=[^`]*$)|~{3,})")
_FENCE_CLOSE_RE = re.compile(r"^\s*(`{3,}|~{3,})\s*$")
_HEADING_RE = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")


def _fence_states(body: str):
    """Yield (line, in_fence) for each line; fence lines count as in_fence.

    Ends with (None, unclosed), where unclosed is True if a fence is still open.
    """
    fence = None  # the opening run, e.g. "````" or "~~~"
    for line in body.splitlines():
        if fence is not None:
            m = _FENCE_CLOSE_RE.match(line)
            run = m.group(1) if m else ""
            if run and run[0] == fence[0] and len(run) >= len(fence):
                fence = None
            yield line, True
            continue
        m = _FENCE_OPEN_RE.match(line)
        if m:
            fence = m.group(1)
            yield line, True
            continue
        yield line, False
    yield None, fence is not None


def has_unclosed_fence(body: str) -> bool:
    """True if a code fence is still open at the end of the text."""
    for line, in_fence in _fence_states(body):
        if line is None:
            return in_fence
    return False


def iter_markdown_lines(body: str):
    """Yield (line, heading_level, heading_text) for lines outside code fences.

    heading_level is 0 for non-heading lines.
    """
    for line, in_fence in _fence_states(body):
        if line is None or in_fence:
            continue
        h = _HEADING_RE.match(line)
        if h:
            yield line, len(h.group(1)), h.group(2)
        else:
            yield line, 0, ""


def section_lines(body: str, heading_prefix: str, last: bool = True) -> Optional[List[str]]:
    """Lines of a `## <heading_prefix>...` section (the last one if several)."""
    sections: List[List[str]] = []
    current: Optional[List[str]] = None
    prefix = heading_prefix.lower()
    for line, level, text in iter_markdown_lines(body):
        if level:
            if level <= 2:
                current = None
            if level == 2 and text.lower().startswith(prefix):
                current = []
                sections.append(current)
            continue
        if current is not None:
            current.append(line)
    if not sections:
        return None
    return sections[-1] if last else sections[0]


_QUESTION_RE = re.compile(r"^\s*(?:[-*]\s+)?\*\*Q(\d+)\.")
ACCEPTED_BY_DEFAULT = "accepted by default"


def count_open_questions(body: str) -> int:
    """Count `**Q<n>.` items under the latest `## Open Questions` heading.

    Items whose text says "accepted by default" are not open.
    """
    lines = section_lines(body, "open questions")
    if not lines:
        return 0
    items: List[List[str]] = []
    for line in lines:
        if _QUESTION_RE.match(line):
            items.append([line])
        elif items:
            items[-1].append(line)
    count = 0
    for item in items:
        if ACCEPTED_BY_DEFAULT not in "\n".join(item).lower():
            count += 1
    return count


def count_accepted_by_default(body: str) -> int:
    """Count lines (outside code fences) marked "accepted by default"."""
    return sum(
        1 for line, level, _ in iter_markdown_lines(body)
        if not level and ACCEPTED_BY_DEFAULT in line.lower()
    )


_CHECKBOX_RE = re.compile(r"^\s*[-*+]\s+\[([ xX])\]\s*(?:(\d+)[.)])?")


def parse_phase_overview(body: str) -> List[Tuple[int, bool]]:
    """Return [(phase number, checked)] from the plan's `## Phase Overview`."""
    lines = section_lines(body, "phase overview", last=False)
    if not lines:
        return []
    matches = [(m, len(line) - len(line.lstrip())) for line in lines for m in [_CHECKBOX_RE.match(line)] if m]
    if not matches:
        return []
    # Only top-level items count: indented sub-checkboxes are not phases.
    top_indent = min(indent for _, indent in matches)
    result: List[Tuple[int, bool]] = []
    for m, indent in matches:
        if indent != top_indent:
            continue
        number = int(m.group(2)) if m.group(2) else len(result) + 1
        result.append((number, m.group(1) in "xX"))
    return result


_LOG_HEADING_RE = re.compile(
    r"^##\s+Phase\s+(\d+)\s*[—–-]+\s*(done|in-progress|blocked)\b"
    r"(?:\s*[—–-]+\s*(.+?))?\s*$",
    re.IGNORECASE,
)
_REASON_RE = re.compile(r"^\s*Reason:\s*(.+?)\s*$", re.IGNORECASE)


def parse_log(text: str) -> Dict[int, Dict[str, Any]]:
    """Parse log.md headings `## Phase N — done|in-progress|blocked[ — <x>]`.

    The last heading for a phase wins. For `done`, <x> is the commit hash; for
    `blocked`, a `Reason:` line (or <x>) is the reason.
    """
    phases: Dict[int, Dict[str, Any]] = {}
    current: Optional[Dict[str, Any]] = None
    for line, level, _ in iter_markdown_lines(text):
        if level:
            m = _LOG_HEADING_RE.match(line.strip())
            if m:
                number = int(m.group(1))
                status = m.group(2).lower()
                extra = m.group(3)
                current = {"status": status, "commit": None, "reason": None}
                if status == "done" and extra:
                    current["commit"] = extra.split()[0]
                elif status == "blocked" and extra:
                    current["reason"] = extra
                phases[number] = current
            elif level <= 2:
                current = None
            continue
        if current is not None and current["status"] == "blocked" and not current["reason"]:
            r = _REASON_RE.match(line)
            if r:
                current["reason"] = r.group(1)
    return phases


def implementation_progress(
    mode: Optional[str], plan_body: Optional[str], log_text: Optional[str]
) -> Tuple[Dict[str, Any], List[str]]:
    """Combine plan Phase Overview checkboxes and log.md headings.

    A log.md entry wins over the checkbox for the same phase. oneshot has one
    implicit phase that only log.md tracks.
    """
    warnings: List[str] = []
    log = parse_log(log_text) if log_text else {}
    checked: Dict[int, bool] = {}
    # The plan's Phase Overview could not be read reliably: no checkboxes, or
    # an unclosed code fence (the rest of the plan is ignored). Skills test
    # this flag, not the warning texts.
    plan_parse_error = False
    if mode == "oneshot":
        numbers = {1}
    else:
        overview = parse_phase_overview(plan_body) if plan_body is not None else []
        if plan_body is not None and not overview:
            warnings.append("%s has no Phase Overview checkboxes" % PLAN_FILE)
        plan_parse_error = plan_body is not None and (not overview or has_unclosed_fence(plan_body))
        for number, is_checked in overview:
            checked[number] = is_checked
        numbers = set(checked)
    numbers |= set(log)
    phases = []
    for number in sorted(numbers):
        entry = log.get(number)
        if entry:
            status = entry["status"]
        else:
            status = "done" if checked.get(number) else "pending"
        phases.append({
            "number": number,
            "status": status,
            "commit": entry["commit"] if entry else None,
        })
    blocked = None
    in_progress = None
    for phase in phases:
        if phase["status"] == "blocked" and blocked is None:
            reason = log[phase["number"]]["reason"]
            blocked = {"phase": phase["number"], "reason": reason}
        if phase["status"] == "in-progress" and in_progress is None:
            in_progress = phase["number"]
    return {
        "total": len(phases),
        "done": sum(1 for p in phases if p["status"] == "done"),
        "inProgress": in_progress,
        "blocked": blocked,
        "phases": phases,
        "planParseError": plan_parse_error,
    }, warnings


# ---------------------------------------------------------------------------
# Task lookup
# ---------------------------------------------------------------------------


def _task_dirs(parent: str, number: int) -> List[str]:
    try:
        names = os.listdir(parent)
    except OSError:
        return []
    prefix = "%d-" % number
    return sorted(
        n for n in names
        if n.startswith(prefix) and os.path.isdir(os.path.join(parent, n))
    )


def find_task_dir(work_dir: str, number: int, slug: str = "") -> Tuple[Optional[str], bool, List[str]]:
    """Find `<workDir>/<n>-*`, then `<workDir>/_archive/<n>-*`.

    Returns (absolute path or None, archived, warnings). Matching is by number,
    so a renamed slug still finds the directory.
    """
    warnings: List[str] = []
    for parent, archived in ((work_dir, False), (os.path.join(work_dir, ARCHIVE_DIR), True)):
        names = _task_dirs(parent, number)
        if not names:
            continue
        chosen = names[0]
        if len(names) > 1:
            exact = "%d-%s" % (number, slug)
            chosen = exact if exact in names else names[0]
            warnings.append(
                "several task directories for #%d: %s; using %s" % (number, ", ".join(names), chosen)
            )
        return os.path.join(parent, chosen), archived, warnings
    return None, False, warnings


def read_text(path: str) -> Optional[str]:
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return None


_NUMBER_RE = re.compile(r"#?([0-9]+)")


def normalize_mode(raw: Any) -> Any:
    """The ticket `mode`: case and surrounding whitespace do not matter (`Quick` is quick).

    Another value is returned unchanged; callers treat it as invalid.
    """
    if isinstance(raw, str) and raw.strip().lower() in MODES:
        return raw.strip().lower()
    return raw


def _to_int(value: Any) -> Optional[int]:
    """`57` or `#57` as an int; None for anything else (only ASCII digits count)."""
    if value is None:
        return None
    m = _NUMBER_RE.fullmatch(str(value).strip())
    return int(m.group(1)) if m else None


# ---------------------------------------------------------------------------
# Working tree and stale research
# ---------------------------------------------------------------------------


def _is_under(path: str, prefix: str) -> bool:
    prefix = prefix.rstrip("/")
    return path == prefix or path.startswith(prefix + "/")


def working_tree_status(
    top: str, cfg: Dict[str, Any], extra_ignore: Tuple[str, ...] = ()
) -> Tuple[Optional[str], List[str]]:
    """Return ("clean" | "dirty", warnings). Files under workDir are ignored.

    extra_ignore: more paths (relative to top) whose changes do not count, at
    or below each path, e.g. the Stop hook ignores `.loom/` and the docs paths.
    """
    rc, out, err = git(["status", "--porcelain=v1", "-z", "--untracked-files=all"], top)
    if rc != 0:
        return None, ["git status failed: %s" % (err.strip().splitlines() or ["?"])[0]]
    ignored = [rel_to(top, work_dir_abs(top, cfg))]
    ignored += [rel_to(top, os.path.normpath(os.path.join(top, d))) for d in extra_ignore]
    entries = out.split("\0")
    i = 0
    while i < len(entries):
        entry = entries[i]
        i += 1
        if len(entry) < 4:
            continue
        code, path = entry[:2], entry[3:]
        paths = [path]
        if "R" in code or "C" in code:
            if i < len(entries):
                paths.append(entries[i])
            i += 1
        if not all(any(_is_under(p, d) for d in ignored) for p in paths):
            return "dirty", []
    return "clean", []


# Path-like tokens; a `:line` or `:line-line` suffix is not part of the token.
_PATH_RE = re.compile(r"(?<![\w/.@:-])((?:\.{0,2}/)?[\w@.+-]+(?:/[\w@.+-]+)*)")
_EXT_RE = re.compile(r"[^/.][^/]*\.[A-Za-z0-9_]+$")

# Well-known file names without an extension.
KNOWN_FILE_NAMES = {
    "Makefile", "GNUmakefile", "Dockerfile", "Containerfile", "Justfile", "justfile",
    "Rakefile", "Gemfile", "Procfile", "Vagrantfile", "Brewfile", "Pipfile",
    "LICENSE", "NOTICE", "CODEOWNERS",
}


def research_references(body: str) -> List[str]:
    """Paths referenced in research as `path:line` or `path`.

    A token counts when it has a file extension, contains `/` (for example
    `bin/loom-state`), or is a well-known name such as `Makefile`.
    False positives are harmless: they are only matched against changed files.
    """
    refs = set()
    for m in _PATH_RE.finditer(body):
        path = m.group(1).rstrip(".")
        if body[m.end():m.end() + 3] == "://":
            continue  # URL scheme
        while path.startswith("./"):
            path = path[2:]
        path = path.rstrip("/")
        if not path or path.startswith("../"):
            continue
        name = path.rsplit("/", 1)[-1]
        if "/" in path or _EXT_RE.match(name) or name in KNOWN_FILE_NAMES:
            refs.add(path)
    return sorted(refs)


def main_ref(top: str, main_branch: str) -> Optional[str]:
    """origin/<main> if it exists, otherwise the local main branch."""
    for ref in ("refs/remotes/origin/%s" % main_branch, "refs/heads/%s" % main_branch):
        if git_out(["rev-parse", "--verify", "--quiet", ref + "^{commit}"], top):
            return ref
    return None


def stale_research(
    top: str, cfg: Dict[str, Any], git_commit: Optional[str], body: str
) -> Tuple[bool, List[str], List[str]]:
    """Return (stale, changed referenced files, warnings) per LOOM_SPEC.md 8.3.

    Stale when files referenced in research changed on main between the
    research `git_commit` and merge-base(HEAD, origin/<main>). Commits of the
    task branch do not count. Any failure gives stale=false and a warning.
    """
    if not git_commit:
        return False, [], ["%s has no git_commit; stale check skipped" % RESEARCH_FILE]
    commit = git_out(["rev-parse", "--verify", "--quiet", "%s^{commit}" % git_commit], top)
    if not commit:
        return False, [], ["research git_commit %s not found; stale check skipped" % git_commit]
    ref = main_ref(top, cfg["mainBranch"])
    if not ref:
        return False, [], ["main branch %r not found; stale check skipped" % cfg["mainBranch"]]
    base = git_out(["merge-base", "HEAD", ref], top)
    if not base:
        return False, [], ["no merge-base of HEAD and %s; stale check skipped" % ref]
    # A...B diffs from merge-base(A, B) to B: only changes on main count.
    rc, out, err = git(["diff", "--name-only", "--no-renames", "%s...%s" % (commit, base)], top)
    if rc != 0:
        return False, [], ["git diff for stale check failed: %s" % (err.strip().splitlines() or ["?"])[0]]
    changed = set(line.strip() for line in out.splitlines() if line.strip())
    refs = set(research_references(body))
    hits = sorted(changed & refs)
    return bool(hits), hits, []


# ---------------------------------------------------------------------------
# Pull request state (--pr)
# ---------------------------------------------------------------------------

_FAIL_CONCLUSIONS = {"FAILURE", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE", "STALE"}
_FAIL_STATES = {"FAILURE", "ERROR"}
_PENDING_STATES = {"PENDING", "EXPECTED", "QUEUED", "IN_PROGRESS", "WAITING", "REQUESTED"}


def _is_status_context(item: Dict[str, Any]) -> bool:
    return item.get("__typename") == "StatusContext" or ("state" in item and "conclusion" not in item)


def check_item_state(item: Any) -> Optional[str]:
    """One statusCheckRollup entry as passing | failing | pending; None if not an object."""
    if not isinstance(item, dict):
        return None
    if _is_status_context(item):
        state = str(item.get("state") or "").upper()
        if state in _FAIL_STATES:
            return "failing"
        if state in _PENDING_STATES or not state:
            return "pending"
        return "passing"
    status = str(item.get("status") or "").upper()
    conclusion = str(item.get("conclusion") or "").upper()
    if status and status != "COMPLETED":
        return "pending"
    if conclusion in _FAIL_CONCLUSIONS:
        return "failing"
    if not conclusion:
        return "pending"
    return "passing"


def check_item_name(item: Any) -> Optional[str]:
    """The check's name as GitHub shows it: `name` of a check run, `context` of a status."""
    if not isinstance(item, dict):
        return None
    value = item.get("context") if _is_status_context(item) else item.get("name")
    return value if isinstance(value, str) and value else None


def summarize_checks(rollup: Any) -> str:
    """Reduce gh statusCheckRollup to passing | failing | pending | none."""
    if not isinstance(rollup, list) or not rollup:
        return "none"
    states = set(check_item_state(item) for item in rollup)
    if "failing" in states:
        return "failing"
    if "pending" in states:
        return "pending"
    return "passing"


def checks_by_name(rollup: Any) -> Dict[str, str]:
    """{check name: state} of the latest entry per name (a rerun adds an entry).

    Latest: the greatest `startedAt` (ISO 8601 compares as text), then the
    later position in the list.
    """
    latest: Dict[str, Tuple[str, int, str]] = {}
    for index, item in enumerate(rollup if isinstance(rollup, list) else []):
        name, state = check_item_name(item), check_item_state(item)
        if name is None or state is None:
            continue
        started = item.get("startedAt") if isinstance(item.get("startedAt"), str) else ""
        key = (started, index, state)
        if name not in latest or key[:2] >= latest[name][:2]:
            latest[name] = key
    return {name: key[2] for name, key in latest.items()}


def required_check_state(rollup: Any, name: str) -> str:
    """State of the check named ci.requiredCheck: passing | failing | pending | missing."""
    return checks_by_name(rollup).get(name, "missing")


def behind_main(top: str, cfg: Dict[str, Any], fetch: bool = True) -> Tuple[Optional[int], List[str]]:
    """Number of commits on origin/<main> (or local main) missing from HEAD."""
    warnings: List[str] = []
    main_branch = cfg["mainBranch"]
    if fetch and git_out(["remote", "get-url", "origin"], top):
        rc, _, err = git(["fetch", "--quiet", "origin", main_branch], top, timeout=GH_TIMEOUT,
                         extra_env=non_interactive_env(top))
        if rc != 0:
            warnings.append("git fetch origin %s failed: %s" % (main_branch, (err.strip().splitlines() or ["?"])[0]))
    ref = main_ref(top, main_branch)
    if not ref:
        return None, warnings + ["main branch %r not found" % main_branch]
    count = git_out(["rev-list", "--count", "HEAD..%s" % ref], top)
    if count is None or not count.isdigit():
        return None, warnings + ["cannot count commits behind %s" % ref]
    return int(count), warnings


def fetch_pr(top: str, cfg: Dict[str, Any]) -> Tuple[Optional[Dict[str, Any]], List[str]]:
    rc, out, err = run(
        ["gh", "pr", "view", "--json", "number,state,reviewDecision,statusCheckRollup,mergeStateStatus"],
        top,
        timeout=GH_TIMEOUT,
    )
    if rc == 127:
        return None, ["gh is not installed; PR state unknown"]
    if rc != 0:
        first = (err.strip().splitlines() or ["unknown error"])[0]
        return None, ["gh pr view: %s" % first]
    try:
        data = json.loads(out)
    except ValueError:
        return None, ["gh pr view returned invalid JSON"]
    if not isinstance(data, dict):
        return None, ["gh pr view returned no JSON object; PR state unknown"]
    behind, warnings = behind_main(top, cfg)
    rollup = data.get("statusCheckRollup")
    required_name = (cfg.get("ci") or DEFAULT_CI)["requiredCheck"]
    required = required_check_state(rollup, required_name)
    pr = {
        "number": data.get("number"),
        "state": data.get("state"),
        "reviewDecision": data.get("reviewDecision") or None,
        "checks": summarize_checks(rollup),
        "requiredCheck": required,
        "mergeStateStatus": data.get("mergeStateStatus"),
        "behindMain": behind,
    }
    if required != "missing":
        others = sorted(name for name, state in checks_by_name(rollup).items()
                        if state == "failing" and name != required_name)
        if others:
            warnings.append("PR #%s has failing checks besides the required check '%s': %s"
                            % (pr["number"], required_name, ", ".join(others)))
    return pr, warnings


# ---------------------------------------------------------------------------
# Subagent events and process metrics (LOOM_SPEC.md 11.6)
# ---------------------------------------------------------------------------

# Phase names of events.jsonl in lifecycle order; `iterate` is the work after
# the last implementation phase is done (fixes before and after the PR).
EVENT_PHASES = ("research-questions", "research", "design", "plan", "implement", "iterate")
REVIEWER_AGENT = "implementation-reviewer"


def task_phase(
    mode: Optional[str], artifacts: List[Dict[str, Any]], impl: Optional[Dict[str, Any]]
) -> Tuple[Optional[str], Optional[int]]:
    """The phase a task is in, as (phase, implementation phase number or None).

    Pure function, used by the subagent events hook. First matching rule wins:
    1. an implementation phase is in progress: implement, that phase;
    2. implementation started (also with a blocked phase), not oneshot, and a
       gate artifact of the mode is draft or in review (a design or plan change,
       decide_next row 4): the first such gate;
    3. an implementation phase is blocked: implement, that phase;
    4. implementation started: implement, the first phase not done; all done: iterate;
    5. oneshot: implement, phase 1;
    6. an artifact of the mode's phases is draft: the latest such phase;
    7. a gate artifact is in review: the first such gate;
    8. the phase after the latest existing artifact; after the plan: implement,
       the first phase not done.
    An invalid mode gives (None, None).
    """
    impl = impl or {}
    phases = impl.get("phases") or []
    if impl.get("inProgress") is not None:
        return "implement", impl["inProgress"]
    blocked = impl.get("blocked")
    not_done = [p.get("number") for p in phases if p.get("status") != "done"]
    status = {a.get("phase"): a.get("status") for a in artifacts}
    started = bool(blocked) or any(p.get("status") != "pending" for p in phases)
    if started and mode != "oneshot":
        for gate in GATES_BY_MODE.get(mode, []):
            if status.get(gate) in ("draft", "in-review"):
                return gate, None
    if blocked:
        return "implement", blocked.get("phase")
    if started:
        return ("implement", not_done[0]) if not_done else ("iterate", None)
    if mode == "oneshot":
        return "implement", 1
    if mode not in MODES:
        return None, None
    sequence = PHASES_BY_MODE[mode]
    drafts = [p for p in sequence if status.get(p) == "draft"]
    if drafts:
        return drafts[-1], None
    for gate in GATES_BY_MODE[mode]:
        if status.get(gate) == "in-review":
            return gate, None
    existing = [i for i, p in enumerate(sequence) if p in status]
    following = max(existing) + 1 if existing else 0
    if following < len(sequence):
        return sequence[following], None
    return "implement", not_done[0] if not_done else 1


def event_context(cwd: str) -> Optional[Dict[str, Any]]:
    """Task directory and phase for the subagent events hook.

    Returns {"dir": <absolute task directory>, "phase": ..., "implementationPhase": ...,
    "check": <checks.check>},
    or None outside a loom project, on the main branch, on a branch without a
    task directory, and for an archived task. Reads only files and the branch
    (no git status, no stale check), so the hook stays fast.
    """
    top = find_toplevel(cwd)
    if not top:
        return None
    cfg, _ = load_config(top)
    if cfg is None:
        return None
    branch, _ = task_branch(top)
    m = BRANCH_RE.match(branch or "")
    if not m or branch == cfg["mainBranch"]:
        return None
    task_dir, archived, _ = find_task_dir(work_dir_abs(top, cfg), int(m.group(2)), m.group(3))
    if not task_dir or archived:
        return None
    mode = normalize_mode(parse_frontmatter(read_text(os.path.join(task_dir, TICKET_FILE)) or "").get("mode"))
    artifacts = []
    for name, phase in ARTIFACT_FILES:
        text = read_text(os.path.join(task_dir, name))
        if text is not None:
            status, _ = artifact_status(name, parse_frontmatter(text).get("status"))
            artifacts.append({"phase": phase, "status": status})
    plan_text = read_text(os.path.join(task_dir, PLAN_FILE))
    plan_body = split_frontmatter(plan_text)[1] if plan_text is not None else None
    impl, _ = implementation_progress(mode, plan_body, read_text(os.path.join(task_dir, LOG_FILE)))
    phase, number = task_phase(mode, artifacts, impl)
    check = cfg["checks"].get("check")
    if not isinstance(check, str) or not check.strip():
        check = DEFAULT_CONFIG["checks"]["check"]
    return {"dir": task_dir, "phase": phase, "implementationPhase": number, "check": check}


def read_events(path: str) -> List[Dict[str, Any]]:
    """Valid lines of events.jsonl, in file order; malformed lines are skipped.

    A valid line is a JSON object with `event` `start` or `stop` and a
    non-empty string `agent_id`.
    """
    text = read_text(path)
    if text is None:
        return []
    events: List[Dict[str, Any]] = []
    for line in text.splitlines():
        try:
            item = json.loads(line)
        except ValueError:
            continue
        if (
            isinstance(item, dict)
            and item.get("event") in ("start", "stop")
            and isinstance(item.get("agent_id"), str)
            and item["agent_id"]
        ):
            events.append(item)
    return events


def event_session(event: Dict[str, Any]) -> Optional[str]:
    """The `session_id` of an event line; None when it is missing or not a string."""
    value = event.get("session_id")
    return value if isinstance(value, str) and value else None


def _plural(count: int, singular: str, plural: str) -> str:
    return "%d %s" % (count, singular if count == 1 else plural)


def _duration_text(seconds: float) -> str:
    whole = int(round(seconds))
    if whole < 60:
        return "%d s" % whole
    return "%d min" % round(seconds / 60)


def events_metrics(events: List[Dict[str, Any]]) -> Optional[Dict[str, Any]]:
    """Aggregate subagent events into process metrics; None without a run.

    Pure function. A run is one (session_id, agent_id); a missing session_id is
    the value None. A run has one or more segments: each start line opens a
    segment (Claude Code also fires SubagentStart when it resumes a subagent),
    and the stop lines after it close it. Its agent and phase come from its
    first start line (else its first stop line).
    - checks retries: stop lines with stop_hook_active true (a stop hook kept
      the subagent running);
    - review rounds: stop lines of implementation-reviewer with
      stop_hook_active not true (one verdict each); changes-needed counts those
      with the result changes-needed;
    - subagent time: the sum over all segments of the duration_s of the
      segment's last stop line, so parallel runs add up and idle time between
      segments does not count;
    - unfinished: runs whose last line is a start line.
    """
    runs: Dict[Tuple[Optional[str], str], Dict[str, Any]] = {}
    for event in events:
        run = runs.setdefault((event_session(event), event["agent_id"]),
                              {"first": event, "first_start": None, "segments": [], "last": None})
        if event["event"] == "start":
            run["first_start"] = run["first_start"] or event
            run["segments"].append([])
        else:
            if not run["segments"]:
                run["segments"].append([])  # a stop line without a start line
            run["segments"][-1].append(event)
        run["last"] = event["event"]
    if not runs:
        return None
    for run in runs.values():
        source = run["first_start"] or run["first"]
        run["agent"] = source.get("agent")
        run["phase"] = source.get("phase")
    counts: Dict[str, int] = {}
    for run in runs.values():
        phase = run["phase"] if isinstance(run["phase"], str) and run["phase"] else "unknown"
        counts[phase] = counts.get(phase, 0) + 1
    order = list(EVENT_PHASES) + sorted(p for p in counts if p not in EVENT_PHASES)
    by_phase = {p: counts[p] for p in order if p in counts}
    stops = [(run, stop) for run in runs.values() for segment in run["segments"] for stop in segment]
    verdicts = [stop for run, stop in stops if run["agent"] == REVIEWER_AGENT and stop.get("stop_hook_active") is not True]
    changes_needed = sum(1 for stop in verdicts if stop.get("result") == "changes-needed")
    retries = sum(1 for _, stop in stops if stop.get("stop_hook_active") is True)
    unfinished = sum(1 for run in runs.values() if run["last"] == "start")
    seconds = 0.0
    for run in runs.values():
        for segment in run["segments"]:
            value = segment[-1].get("duration_s") if segment else None
            # NaN fails both comparisons; Infinity and absurd values fail the upper bound.
            if isinstance(value, (int, float)) and not isinstance(value, bool) and 0 <= value <= MAX_SEGMENT_SECONDS:
                seconds += value
    parts = ["%s (%s)" % (
        _plural(len(runs), "subagent run", "subagent runs"),
        ", ".join("%s %d" % (p, n) for p, n in by_phase.items()),
    )]
    if verdicts:
        review_text = _plural(len(verdicts), "review round", "review rounds")
        if changes_needed:
            review_text += " (%d changes-needed)" % changes_needed
        parts.append(review_text)
    if retries:
        parts.append(_plural(retries, "checks retry", "checks retries"))
    if unfinished:
        parts.append("%d unfinished" % unfinished)
    parts.append("subagent time %s" % _duration_text(seconds))
    return {
        "runs": len(runs),
        "byPhase": by_phase,
        "reviewRounds": len(verdicts),
        "changesNeeded": changes_needed,
        "checkRetries": retries,
        "unfinished": unfinished,
        "subagentSeconds": round(seconds, 1),
        "line": ", ".join(parts),
    }


def task_metrics(task_dir: str) -> Optional[Dict[str, Any]]:
    """Process metrics from <task dir>/events.jsonl; None without the file or a valid line."""
    return events_metrics(read_events(os.path.join(task_dir, EVENTS_FILE)))


# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------


UNCLOSED_FENCE_WARNING = "%s has an unclosed code fence; the rest of the file is ignored"


def artifact_status(name: str, raw: Any) -> Tuple[Optional[str], List[str]]:
    """Normalize an artifact's frontmatter `status` (LOOM_SPEC.md 13.1).

    Case and surrounding whitespace do not matter (`Approved` is approved).
    A missing status is None. Any other value gets a warning and counts as
    in-review, so no route reruns the phase and overwrites the artifact.
    """
    if raw is None:
        return None, []
    text = raw.strip().lower() if isinstance(raw, str) else ""
    if text in ARTIFACT_STATUSES:
        return text, []
    return "in-review", ["%s has an unknown status %s (allowed: %s); treated as in-review" % (
        name, json.dumps(raw, ensure_ascii=False), ", ".join(ARTIFACT_STATUSES))]


def build_artifacts(
    top: str, cfg: Dict[str, Any], task_dir: str, stale_check: bool = True
) -> Tuple[List[Dict[str, Any]], List[str]]:
    """Artifacts 01-04 that exist. The phase comes from the file name.

    stale_check=False skips the stale research check (`stale` is false
    without a warning): the statusline does not show it.
    """
    artifacts: List[Dict[str, Any]] = []
    warnings: List[str] = []
    for name, phase in ARTIFACT_FILES:
        text = read_text(os.path.join(task_dir, name))
        if text is None:
            continue
        fm, body = split_frontmatter(text)
        status, w = artifact_status(name, fm.get("status"))
        warnings.extend(w)
        if status is None:
            warnings.append("%s has no status in its frontmatter" % name)
        declared = fm.get("phase")
        if declared is not None and (not isinstance(declared, str) or declared.strip().lower() != phase):
            warnings.append("%s has phase %s in its frontmatter; the file name says %s, and the file name wins"
                            % (name, json.dumps(declared, ensure_ascii=False), phase))
        if has_unclosed_fence(body):
            warnings.append(UNCLOSED_FENCE_WARNING % name)
        item: Dict[str, Any] = {
            "file": name,
            "phase": phase,
            "status": status,
            "openQuestions": count_open_questions(body),
        }
        if phase in ("design", "plan"):
            item["acceptedByDefault"] = count_accepted_by_default(body)
        if phase == "research":
            if stale_check:
                stale, files, w = stale_research(top, cfg, fm.get("git_commit"), body)
            else:
                stale, files, w = False, [], []
            item["stale"] = stale
            if files:
                item["staleFiles"] = files
            warnings.extend(w)
        artifacts.append(item)
    return artifacts, warnings


def compute_state(cwd: str, with_pr: bool = False, for_line: bool = False) -> Optional[Dict[str, Any]]:
    """Compute the task state for cwd, or None when loom does not apply.

    for_line: the statusline (`--line`) needs neither the stale research
    check nor workingTreeDocsOnly, so both are skipped.
    """
    top = find_toplevel(cwd)
    if not top:
        return None
    cfg, warnings = load_config(top)
    if cfg is None:
        return None
    main_branch = cfg["mainBranch"]
    branch, rebasing = task_branch(top)
    if rebasing:
        warnings.append("a rebase of %s is in progress (HEAD is detached); continue it with "
                        "`git rebase --continue` or abort it with `git rebase --abort`" % branch)
    state: Dict[str, Any] = {
        "today": datetime.date.today().isoformat(),
        "branch": branch,
        "rebaseInProgress": rebasing,
        "mainBranch": main_branch,
        "onMain": branch == main_branch,
        # Resolved configuration (LOOM_SPEC.md 19.1): skills read these, never loom.json.
        "workDir": cfg["workDir"],
        "docs": cfg["docs"],
        "checks": {key: cfg["checks"].get(key) for key in CHECK_KEYS},
        "ci": cfg["ci"],
        "pullRequest": cfg["pullRequest"],
        "rounds": cfg["rounds"],
        "implement": cfg["implement"],
        "hooks": cfg["hooks"],
        "task": None,
        "artifacts": [],
        "implementation": None,
        "workingTree": None,
        "workingTreeDocsOnly": False,
        "pr": None,
        "next": None,
        "warnings": warnings,
    }
    tree, w = working_tree_status(top, cfg)
    state["workingTree"] = tree
    warnings.extend(w)
    if tree == "dirty" and not for_line:
        # Dirty only in docs paths: below docsDir or at or below a docs map path
        # (an interrupted describe-pr writes docs before its commit).
        docs_tree, _ = working_tree_status(top, cfg, extra_ignore=(LOOM_DIR,) + tuple(docs_change_paths(cfg)))
        state["workingTreeDocsOnly"] = docs_tree == "clean"

    m = BRANCH_RE.match(branch or "")
    if m and not state["onMain"]:
        number = int(m.group(2))
        task_dir, archived, w = find_task_dir(work_dir_abs(top, cfg), number, m.group(3))
        warnings.extend(w)
        if task_dir:
            dirname = os.path.basename(task_dir)
            ticket_text = read_text(os.path.join(task_dir, TICKET_FILE))
            ticket = parse_frontmatter(ticket_text) if ticket_text is not None else {}
            if ticket_text is None:
                warnings.append("%s is missing" % TICKET_FILE)
            size = ticket.get("size")
            if size is not None:
                size = str(size).strip().upper()
                if size not in SIZES:
                    warnings.append("%s has an invalid size (got %r)" % (TICKET_FILE, ticket.get("size")))
                    size = None
            mode = normalize_mode(ticket.get("mode"))
            setup = bool(SETUP_BRANCH_RE.match(branch or ""))
            if mode not in MODES:
                warnings.append("%s has no valid mode (got %r)" % (TICKET_FILE, mode))
                mode = mode or None
            elif setup and mode not in SETUP_MODES:
                warnings.append("%s has no valid mode for the setup task (got %r); no setup path uses %s"
                                % (TICKET_FILE, mode, mode))
            pr_number = _to_int(ticket.get("pr"))
            if pr_number is not None and pr_number < 1:
                pr_number = None  # PR numbers start at 1
            if pr_number is None and ticket.get("pr") is not None:
                warnings.append("%s has an invalid pr %s (a PR number such as 57); ignored"
                                % (TICKET_FILE, json.dumps(ticket.get("pr"), ensure_ascii=False)))
            state["task"] = {
                "number": number,
                "slug": dirname[len("%d-" % number):],
                "dir": rel_to(top, task_dir),
                "mode": mode,
                "size": size,
                "archived": archived,
                # The setup task (LOOM_SPEC.md 9.13.1): known by its branch, not by a ticket field.
                "setup": setup,
                "url": ticket.get("url"),
                "pr": pr_number,
                "metrics": task_metrics(task_dir),
            }
            artifacts, w = build_artifacts(top, cfg, task_dir, stale_check=not for_line)
            state["artifacts"] = artifacts
            warnings.extend(w)
            plan_text = read_text(os.path.join(task_dir, PLAN_FILE))
            plan_body = split_frontmatter(plan_text)[1] if plan_text is not None else None
            log_text = read_text(os.path.join(task_dir, LOG_FILE))
            if log_text is not None and has_unclosed_fence(log_text):
                warnings.append(UNCLOSED_FENCE_WARNING % LOG_FILE)
            impl, w = implementation_progress(mode, plan_body, log_text)
            state["implementation"] = impl
            warnings.extend(w)

    if with_pr and state["task"] and not state["task"]["archived"]:
        pr, w = fetch_pr(top, cfg)
        state["pr"] = pr
        warnings.extend(w)

    warnings.extend(routing_warnings(state))
    state["next"] = decide_next(state)
    return state


# ---------------------------------------------------------------------------
# Decision table (LOOM_SPEC.md section 9.12) - pure function
# ---------------------------------------------------------------------------


def _next(command: str, reason: str) -> Dict[str, str]:
    return {"command": command, "reason": reason}


def _phase_notes(arts: Dict[str, Dict[str, Any]], mode: str) -> str:
    notes = []
    for phase in ("research-questions", "research"):
        if phase not in PHASES_BY_MODE.get(mode, []):
            continue
        art = arts.get(phase)
        if art and art.get("status") == "in-review":
            notes.append("%s not reviewed" % phase)
    research = arts.get("research")
    if research and research.get("stale") and "research" in PHASES_BY_MODE.get(mode, []):
        notes.append("research is stale (referenced files changed on main); consider rerunning /loom:research")
    return "".join("; note: %s" % n for n in notes)


def _route_pr(pr: Dict[str, Any], required_name: Optional[str] = None) -> Optional[Dict[str, str]]:
    """PR routing (LOOM_SPEC.md 6.2). The required check (ci.requiredCheck),
    when the PR reports it, decides instead of the overall checks."""
    number = pr.get("number")
    label = "PR #%s" % number if number is not None else "PR"
    state = str(pr.get("state") or "").upper()
    if state == "MERGED":
        return _next("/loom:finish-task", "%s is merged; /loom:finish-task completes the cleanup" % label)
    if state != "OPEN":
        return None
    required = pr.get("requiredCheck")
    by_required = required in ("passing", "failing", "pending")
    checks = required if by_required else pr.get("checks")
    check_label = "required check '%s'" % required_name if required_name else "the required check"
    if checks == "failing":
        if by_required:
            return _next("/loom:iterate", "%s: %s is failing" % (label, check_label))
        return _next("/loom:iterate", "%s has failing checks" % label)
    if str(pr.get("reviewDecision") or "").upper() == "CHANGES_REQUESTED":
        return _next("/loom:iterate", "%s has requested changes" % label)
    behind = pr.get("behindMain")
    if (isinstance(behind, int) and behind > 0) or str(pr.get("mergeStateStatus") or "").upper() == "BEHIND":
        return _next("/loom:iterate rebase", "%s branch is behind the main branch" % label)
    if checks == "pending":
        if by_required:
            return _next("/loom:finish-task", "%s: %s is pending; /loom:finish-task watches it" % (label, check_label))
        return _next("/loom:finish-task", "%s checks are pending; /loom:finish-task watches them" % label)
    if checks == "none":
        return _next("/loom:finish-task", "%s reports no checks and no requested changes" % label)
    if by_required:
        return _next("/loom:finish-task", "%s: %s passed and no changes are requested" % (label, check_label))
    return _next("/loom:finish-task", "%s checks are green and no changes are requested" % label)


def _impl_started(impl: Dict[str, Any]) -> bool:
    """Implementation started: a log.md entry or a ticked plan phase (LOOM_SPEC.md 9.12 row 4)."""
    return bool(
        impl.get("blocked") or impl.get("inProgress") is not None or (impl.get("done") or 0) > 0
        or any(p.get("status") != "pending" for p in impl.get("phases") or [])
    )


def _plan_artifact(artifacts: List[Dict[str, Any]]) -> Optional[Dict[str, Any]]:
    return next((a for a in artifacts if a.get("phase") == "plan"), None)


def plan_gate_holds(task: Dict[str, Any], artifacts: List[Dict[str, Any]]) -> bool:
    """The implement gate (LOOM_SPEC.md 13.1): oneshot, or quick/full with 04-plan.md approved.

    An invalid mode never holds the gate.

    decide_next never returns /loom:implement while it does not hold.
    """
    mode = task.get("mode")
    if mode == "oneshot":
        return True
    plan = _plan_artifact(artifacts)
    return mode in MODES and plan is not None and plan.get("status") == "approved"


def _all_done(impl: Dict[str, Any]) -> bool:
    total = impl.get("total") or 0
    return total > 0 and (impl.get("done") or 0) >= total


def _plan_reopened(task: Dict[str, Any], artifacts: List[Dict[str, Any]], impl: Dict[str, Any]) -> bool:
    """A plan change after implementation started (row 4): the plan exists and is not approved."""
    plan = _plan_artifact(artifacts)
    return (
        _impl_started(impl)
        and task.get("mode") != "oneshot"
        and plan is not None
        and plan.get("status") != "approved"
    )


def _phase_status(impl: Dict[str, Any], number: int) -> str:
    """Status of one implementation phase: its entry in `phases`, else from the summary fields.

    Without an entry: blocked or in progress as `blocked` and `inProgress`
    say, done when all phases are done, else pending.
    """
    for phase in impl.get("phases") or []:
        if phase.get("number") == number:
            return phase.get("status") or "pending"
    blocked = impl.get("blocked")
    if blocked and blocked.get("phase") == number:
        return "blocked"
    if impl.get("inProgress") == number:
        return "in-progress"
    return "done" if _all_done(impl) else "pending"


# Modes that a setup path writes (LOOM_SPEC.md 5.3): on a setup task `quick` is invalid.
SETUP_MODES = ("oneshot", "full")


def mode_is_valid(task: Dict[str, Any]) -> bool:
    """The ticket has a valid mode: oneshot, quick, or full; on a setup task only oneshot or full."""
    return task.get("mode") in (SETUP_MODES if task.get("setup") else MODES)


def setup_unfinished(task: Dict[str, Any], artifacts: List[Dict[str, Any]], impl: Dict[str, Any]) -> Optional[str]:
    """Why the setup run of a setup task did not finish (LOOM_SPEC.md 9.12 row 2c), or None.

    full: 01-research-questions.md is missing or not approved, and each of
    02-research.md, 03-design.md, and 04-plan.md is missing, draft, or
    without a status (the questions file of the kickoff is not there for
    research; a finished later artifact, in-review or approved, needs it no
    more). So a setup task never routes to /loom:research-questions.
    oneshot: implementation phase 1 is pending or in progress (the fast path
    stopped before or during its commit); a blocked phase 1 stays with row 3.
    """
    if not task.get("setup"):
        return None
    mode = task.get("mode")
    if mode == "full":
        arts = {a.get("phase"): a for a in artifacts}
        questions_file, questions_phase = ARTIFACT_FILES[0]
        for _, phase in ARTIFACT_FILES[1:]:
            later = arts.get(phase)
            if later is not None and later.get("status") not in ("draft", None):
                return None
        questions = arts.get(questions_phase)
        if questions is None:
            return "the questions file of the kickoff is not there for research (%s is missing)" % questions_file
        if questions.get("status") != "approved":
            return "the questions file of the kickoff is not there for research (%s is %s, not approved)" % (
                questions_file, questions.get("status") or "without status")
    if mode == "oneshot":
        status = _phase_status(impl, 1)
        if status in ("pending", "in-progress"):
            return "implementation phase 1 is %s: the fast setup stopped before or during its commit" % status
    return None


UNCOMMITTED_BEFORE_PLAN_WARNING = (
    "working tree has uncommitted changes; they are not part of research, design, or plan "
    "(commit, stash, or discard them before /loom:implement)"
)


def routing_warnings(state: Dict[str, Any]) -> List[str]:
    """Warnings that explain a route of decide_next. Pure function.

    Before the plan gate holds (oneshot, or 04-plan.md approved), a dirty
    tree or a phase in progress does not route to implement (row 5).
    """
    task = state.get("task")
    if state.get("onMain") or not task or task.get("archived"):
        return []
    if not mode_is_valid(task):
        # An invalid mode routes to the mode change (or /loom:setup); the plan is not the reason.
        return []
    impl = state.get("implementation") or {}
    artifacts = state.get("artifacts") or []
    if setup_unfinished(task, artifacts, impl):
        # Row 2c routes to /loom:setup: the uncommitted files are the stopped setup run.
        return []
    if plan_gate_holds(task, artifacts) or _plan_reopened(task, artifacts, impl):
        return []
    warnings: List[str] = []
    if impl.get("inProgress") is not None:
        warnings.append("%s has implementation phase %s in progress, but %s is not approved; "
                        "implementation waits for the plan gate" % (LOG_FILE, impl["inProgress"], PLAN_FILE))
    if state.get("workingTree") == "dirty" and not _all_done(impl):
        warnings.append(UNCOMMITTED_BEFORE_PLAN_WARNING)
    return warnings


# Commands that need a known working tree: never routed while git status failed.
TREE_SENSITIVE_COMMANDS = ("/loom:describe-pr", "/loom:finish-task")


def decide_next(state: Dict[str, Any]) -> Dict[str, str]:
    """Return the next step for a state dict. First matching row wins.

    Pure function: it reads only `state` (the loom-state JSON without `next`).
    Invariants: /loom:implement only while the plan gate holds (oneshot, or
    04-plan.md approved); /loom:describe-pr and /loom:finish-task only with a
    known working tree (`workingTree` clean or dirty, not null after a failed
    git status).
    """
    result = _decide(state)
    if result["command"] in TREE_SENSITIVE_COMMANDS and state.get("workingTree") not in ("clean", "dirty"):
        return _next(
            "/loom:iterate <feedback>",
            "git status failed, so uncommitted changes are unknown; fix the git error in the warnings, "
            "then run /loom:next again (%s needs a known working tree)" % result["command"],
        )
    return result


def _decide(state: Dict[str, Any]) -> Dict[str, str]:
    branch = state.get("branch")
    task = state.get("task")

    # Row 1: on the main branch.
    if state.get("onMain"):
        return _next(
            "/loom:start-task #<n>",
            "on the main branch: pick an issue with /loom:backlog, then start it with /loom:start-task #<n>",
        )

    # Row 2: no task for this branch, or the task is archived.
    if not task:
        m = BRANCH_RE.match(branch or "")
        if m:
            n = int(m.group(2))
            return _next("/loom:start-task #%d" % n, "no task directory for issue #%d" % n)
        return _next(
            "/loom:start-task #<n>",
            "branch %s matches no task" % (branch or "(detached HEAD)"),
        )
    number = task.get("number")
    if task.get("archived"):
        return _next(
            "/loom:start-task #%s" % number,
            "task #%s is archived; /loom:start-task #%s offers to restore it" % (number, number),
        )

    # A stopped rebase of the task branch (HEAD detached): nothing else can
    # run until it is continued or aborted; /loom:iterate rebase handles it.
    if state.get("rebaseInProgress"):
        return _next(
            "/loom:iterate rebase",
            "a rebase of %s is in progress and has to be continued or aborted" % (branch or "the task branch"),
        )

    # Row 2b: an invalid mode. Every later row depends on the mode (gates,
    # phases, the plan gate), so nothing else runs until the mode is set
    # again. setup owns the ticket of the setup task: its re-run writes the
    # mode of its path (LOOM_SPEC.md 5.3); no setup path uses `quick`.
    if not mode_is_valid(task):
        if task.get("setup"):
            problem = "has mode quick, which no setup path uses" if task.get("mode") == "quick" else \
                "has no valid mode"
            return _next("/loom:setup", "%s of setup task #%s %s; /loom:setup writes the mode of its path again"
                         % (TICKET_FILE, number, problem))
        return _next("/loom:iterate mode <oneshot|quick|full>",
                     "%s has no valid mode; set it with a mode change" % TICKET_FILE)

    impl = state.get("implementation") or {}
    artifacts = state.get("artifacts") or []

    # Row 2c: a setup task whose setup run did not finish goes back to
    # /loom:setup: research-questions and implement do not run its first steps.
    unfinished = setup_unfinished(task, artifacts, impl)
    if unfinished:
        return _next("/loom:setup", "setup task #%s: %s; /loom:setup continues it" % (number, unfinished))

    # The plan gate after implementation started: a plan changed by
    # /loom:iterate (draft while the edit runs, then in-review) must be
    # finished and approved again before anything else happens.
    plan = _plan_artifact(artifacts)
    plan_reopened = _plan_reopened(task, artifacts, impl)
    # The implement gate: /loom:implement is never the answer without it.
    gate = plan_gate_holds(task, artifacts)

    # Row 3: a blocked implementation phase while the plan is not reopened
    # (plan approved, no plan, or oneshot). /loom:iterate handles it, also
    # when its unfinished fix leaves the tree dirty. (Artifacts have no
    # `blocked` status: artifact_status() reports it as an unknown status.)
    blocked = impl.get("blocked")
    if blocked and not plan_reopened:
        reason = blocked.get("reason") or "no reason recorded"
        return _next(
            "/loom:iterate <fix>",
            "implementation phase %s is blocked: %s" % (blocked.get("phase"), reason),
        )

    # Row 4: implementation started and the plan is not approved (a plan
    # change), with or without a blocked phase, also with a dirty tree.
    # Comes before the dirty tree (row 5), PR routing (row 8), and
    # describe-pr (row 9). Order: draft, open questions, approve.
    if plan_reopened:
        prefix = (
            "implementation phase %s is blocked; " % blocked.get("phase") if blocked
            else "implementation started; "
        )
        open_q = plan.get("openQuestions") or 0
        if plan.get("status") == "draft":
            return _next("/loom:iterate <feedback>", prefix + "04-plan.md edit not finished (draft)")
        if open_q > 0:
            return _next("/loom:iterate <answers>", prefix + "04-plan.md has %s"
                         % _plural(open_q, "open question", "open questions"))
        return _next(
            "/loom:iterate approve",
            prefix + "04-plan.md is %s and must be approved first" % (plan.get("status") or "without status"),
        )

    # Row 5: an implementation phase in progress, or a dirty working tree
    # while implementation phases are left (resume flow), only while the
    # plan gate holds. Before it holds (no approved plan), the changes are
    # not implementation work: fall through to the later rows; compute_state
    # adds a warning (routing_warnings). With all phases done, a dirty tree
    # is not implement's work: changes only below docsDir are an interrupted
    # describe-pr (fall through, normally to row 9), and code changes go to
    # /loom:iterate.
    total = impl.get("total") or 0
    done = impl.get("done") or 0
    all_done = _all_done(impl)
    if impl.get("inProgress") is not None and gate:
        return _next(
            "/loom:implement",
            "implementation phase %s is in progress (resume flow)" % impl["inProgress"],
        )
    if state.get("workingTree") == "dirty":
        if not all_done:
            if gate:
                return _next("/loom:implement", "working tree has uncommitted changes (resume flow)")
        else:
            pr_state = state.get("pr")
            if isinstance(pr_state, dict) and str(pr_state.get("state") or "").upper() == "MERGED":
                # The work is merged: /loom:finish-task cleans up (it offers a stash first).
                return _route_pr(pr_state)
            if not state.get("workingTreeDocsOnly"):
                return _next(
                    "/loom:iterate <feedback>",
                    "uncommitted code changes after all %d implementation phases are done; "
                    "/loom:iterate keeps them as a fix or stashes or discards them" % total,
                )

    mode = task.get("mode")
    arts = {a.get("phase"): a for a in artifacts}
    notes = _phase_notes(arts, mode)
    gates = [arts[p] for p in GATES_BY_MODE[mode] if p in arts]

    # Gate work beats PR routing and "all phases done": a design or plan that
    # went back to review (e.g. a plan change after the PR) is never skipped.
    # Rows 6 and 7 consider only gates in review: an approved gate is done,
    # and a draft gate before implementation is unfinished, so row 11 reruns
    # its phase (after implementation started, row 4 handles a draft plan).
    # Row 6: a gate artifact has open questions.
    for item in gates:
        if item.get("status") == "in-review" and (item.get("openQuestions") or 0) > 0:
            return _next(
                "/loom:iterate <answers>",
                "%s has %s%s" % (item.get("phase"), _plural(item["openQuestions"], "open question",
                                                            "open questions"), notes),
            )

    # Row 7: a gate artifact is in review with no open questions.
    for item in gates:
        if item.get("status") == "in-review":
            return _next(
                "/loom:iterate approve",
                "%s is in review with no open questions%s" % (item.get("phase"), notes),
            )

    # Row 8: pull request routing (section 6.2). With implementation phases
    # left and the plan gate (a plan change after the PR), an open PR goes to
    # implement first, before every OPEN sub-route; so does a PR known only
    # from the ticket (state not read: no --pr).
    pr = state.get("pr")
    if isinstance(pr, dict) and str(pr.get("state") or "").upper() == "OPEN" and not all_done and gate:
        return _next(
            "/loom:implement",
            "PR #%s is open and %d of %d implementation phases are done" % (pr.get("number"), done, total),
        )
    if isinstance(pr, dict):
        routed = _route_pr(pr, (state.get("ci") or {}).get("requiredCheck"))
        if routed:
            return routed
    elif task.get("pr"):
        if all_done:
            return _next(
                "/loom:finish-task",
                "PR #%s exists but its state was not read (loom-state --pr); "
                "/loom:finish-task checks it before merging" % task["pr"],
            )
        if gate:
            return _next(
                "/loom:implement",
                "PR #%s exists (its state was not read) and %d of %d implementation phases are done"
                % (task["pr"], done, total),
            )

    # Row 9: all implementation phases done.
    if all_done:
        return _next("/loom:describe-pr", "all %d implementation phases are done" % total)

    # Row 10: plan approved (or oneshot) and implementation phases left.
    if gate:
        if total == 0 or done < total:
            if total:
                reason = "%d of %d implementation phases done" % (done, total)
            else:
                reason = "implementation not started"
            return _next("/loom:implement", reason + notes)

    # Row 11: the next missing phase for the mode. Non-gate artifacts never
    # block: a later phase that already exists wins over an earlier one.
    sequence = PHASES_BY_MODE[mode]
    reached = -1
    for index, phase in enumerate(sequence):
        art = arts.get(phase)
        if art and art.get("status") in REVIEWED_STATUSES:
            reached = index
    if reached + 1 < len(sequence):
        phase = sequence[reached + 1]
        art = arts.get(phase)
        if art is None:
            reason = "%s is missing" % PHASE_FILE[phase]
        else:
            reason = "%s is %s (unfinished)" % (PHASE_FILE[phase], art.get("status") or "without status")
        return _next(PHASE_COMMAND[phase], reason + notes)
    # Unreachable with a valid state: the plan reached here is approved (row
    # 10) or in review (row 7). Keep the implement gate anyway.
    if gate:
        return _next("/loom:implement", "no missing phase found" + notes)
    return _next("/loom:plan", "%s is not approved and no other route applies%s" % (PLAN_FILE, notes))


# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------


def format_line(state: Optional[Dict[str, Any]]) -> str:
    """One statusline, e.g. `#42 · full · design:in-review · 3 open Q`."""
    if not state or not state.get("task"):
        return ""
    task = state["task"]
    parts = ["#%s" % task.get("number")]
    if task.get("archived"):
        parts.append("archived")
        return " · ".join(parts)
    parts.append(task.get("mode") or "no mode")
    impl = state.get("implementation") or {}
    phases = impl.get("phases") or []
    started = any(p.get("status") != "pending" for p in phases)
    if started or task.get("mode") == "oneshot":
        parts.append("impl %d/%d" % (impl.get("done") or 0, impl.get("total") or 0))
        if impl.get("blocked"):
            parts.append("blocked")
        elif impl.get("inProgress") is not None:
            parts.append("in progress")
    else:
        artifacts = state.get("artifacts") or []
        mode = task.get("mode")
        if mode in MODES:
            # Only the mode's phases: after a mode change, a leftover design does not show.
            artifacts = [a for a in artifacts if a.get("phase") in PHASES_BY_MODE[mode]]
        if artifacts:
            latest = artifacts[-1]
            parts.append("%s:%s" % (latest.get("phase"), latest.get("status") or "?"))
            if latest.get("openQuestions"):
                parts.append("%d open Q" % latest["openQuestions"])
        else:
            parts.append("ticket")
    pr = state.get("pr")
    pr_number = pr.get("number") if isinstance(pr, dict) else task.get("pr")
    if pr_number:
        parts.append("PR #%s" % pr_number)
    return " · ".join(parts)


# ---------------------------------------------------------------------------
# Branch slug (LOOM_SPEC.md section 9.3 step 5)
# ---------------------------------------------------------------------------

SLUG_MAX_WORDS = 5
SLUG_MAX_CHARS = 40
SLUG_FALLBACK = "task"
# Letters that NFKD does not decompose into ASCII.
SLUG_TRANSLITERATION = {
    "ß": "ss", "ẞ": "SS", "æ": "ae", "Æ": "AE", "œ": "oe", "Œ": "OE",
    "ø": "o", "Ø": "O", "đ": "d", "Đ": "D", "ł": "l", "Ł": "L", "þ": "th", "Þ": "TH",
}


def slugify(title: str) -> str:
    """Issue title -> branch slug: lowercase ASCII, non-alphanumerics -> `-`.

    At most 5 words and 40 characters. Words are dropped from the end until the
    slug fits; a single word longer than 40 characters is cut. A title with no
    ASCII letters or digits gives `task`. A few letters that NFKD keeps
    (`ß`, `æ`, `œ`, `ø`, `đ`, `ł`, `þ`) are transliterated first.
    """
    for char, ascii_form in SLUG_TRANSLITERATION.items():
        title = title.replace(char, ascii_form)
    ascii_text = unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode("ascii")
    words = [w for w in re.split(r"[^a-z0-9]+", ascii_text.lower()) if w][:SLUG_MAX_WORDS]
    while len(words) > 1 and len("-".join(words)) > SLUG_MAX_CHARS:
        words.pop()
    slug = "-".join(words)[:SLUG_MAX_CHARS].strip("-") or SLUG_FALLBACK
    # The setup task owns `loom-setup` (LOOM_SPEC.md 9.13.1): start-task never
    # creates a branch chore/<n>-loom-setup.
    return SETUP_SLUG_REPLACEMENT if slug == SETUP_SLUG else slug


# ---------------------------------------------------------------------------
# Setup path (LOOM_SPEC.md section 9.13.1)
# ---------------------------------------------------------------------------

# Files that are not code (LOOM_SPEC.md 9.13.1): names at the git top level, in
# any letter case (compared in lower case); files below .github/ count too,
# except .github/workflows/.
NON_CODE_PATTERNS = ("readme*", "license*", ".gitignore", ".gitattributes", ".editorconfig", "codeowners",
                     "security.md", "code_of_conduct.md", "contributing.md")
GITHUB_DIR = ".github"
WORKFLOWS_DIR = ".github/workflows"

# Agent instruction files of the onboarding research question 4 (LOOM_SPEC.md
# 9.13.3), at any depth: file names, and directories listed once as the directory.
INSTRUCTION_FILE_NAMES = ("AGENTS.md", "CLAUDE.md", "CLAUDE.local.md", ".cursorrules", "GEMINI.md")
INSTRUCTION_FILE_PATHS = (".github/copilot-instructions.md",)
INSTRUCTION_DIRS = (".claude/rules", ".cursor/rules", ".github/instructions")
# PR template locations that GitHub reads: the top level, .github/, and docs/.
PR_TEMPLATE_DIRS = ("", ".github", "docs")
PR_TEMPLATE_NAME = "pull_request_template"
# Documentation directories, at any depth and in any letter case.
DOCS_DIR_NAMES = ("docs", "doc", "adr", "decisions")
# At most this many paths per list of `found`; research finds the rest.
FOUND_LIMIT = 20

KICKOFF_SUBJECT = "chore(loom): start loom setup (#%d)"
FAST_SETUP_SUBJECT = "chore(loom): set up loom (#%d)"


class SetupPathError(Exception):
    """--setup-path cannot decide: a git command failed, or the main branch is missing."""


def is_code_file(path: str) -> bool:
    """True if a tracked path counts as code for the setup path (LOOM_SPEC.md 9.13.1).

    Not code, at the git top level and in any letter case: README*,
    LICENSE*, .gitignore, .gitattributes, .editorconfig, CODEOWNERS,
    SECURITY.md, CODE_OF_CONDUCT.md, CONTRIBUTING.md, and files below
    .github/ except .github/workflows/.
    """
    lower = path.lower()
    if _is_under(lower, WORKFLOWS_DIR):
        return True
    if lower.startswith(GITHUB_DIR + "/"):
        return False
    if "/" in lower:
        return True
    return not any(fnmatch.fnmatchcase(lower, pattern) for pattern in NON_CODE_PATTERNS)


def _dir_paths(path: str) -> List[str]:
    """The directories that contain a path: `a/b/c.md` -> [`a`, `a/b`]."""
    parts = path.split("/")[:-1]
    return ["/".join(parts[:i]) for i in range(1, len(parts) + 1)]


def _shortest_first(paths: Set[str]) -> List[str]:
    """At most FOUND_LIMIT paths: the fewest path segments first, then alphabetical."""
    return sorted(paths, key=lambda p: (p.count("/"), p))[:FOUND_LIMIT]


def found_paths(files: List[str]) -> Dict[str, List[str]]:
    """Paths for the Key Context Pointers of the onboarding questions (LOOM_SPEC.md 8.2, 9.13.2).

    Pure function over tracked paths: instruction files of research question 4
    at any depth (a rules or instructions directory is listed once, as the
    directory), the workflow files, the PR templates, and the directories
    docs, doc, adr, and decisions at any depth and in any letter case. Each
    list holds at most FOUND_LIMIT paths, the fewest path segments first, then
    alphabetical.
    """
    instruction: Set[str] = set()
    workflows: Set[str] = set()
    templates: Set[str] = set()
    docs_dirs: Set[str] = set()
    for path in files:
        name = path.rsplit("/", 1)[-1]
        dirs = _dir_paths(path)
        rules = next((d for d in dirs if any(d == r or d.endswith("/" + r) for r in INSTRUCTION_DIRS)), None)
        if rules is not None:
            instruction.add(rules)
        elif name in INSTRUCTION_FILE_NAMES or any(path == p or path.endswith("/" + p) for p in INSTRUCTION_FILE_PATHS):
            instruction.add(path)
        parent = posixpath.dirname(path)
        if parent == WORKFLOWS_DIR and name.lower().endswith((".yml", ".yaml")):
            workflows.add(path)
        if parent in PR_TEMPLATE_DIRS and name.lower().startswith(PR_TEMPLATE_NAME + "."):
            templates.add(path)
        elif posixpath.basename(parent).lower() == PR_TEMPLATE_NAME and posixpath.dirname(parent) in PR_TEMPLATE_DIRS:
            templates.add(path)
        for directory in dirs:
            if directory.rsplit("/", 1)[-1].lower() in DOCS_DIR_NAMES:
                docs_dirs.add(directory)
    return {"instructionFiles": _shortest_first(instruction), "workflows": _shortest_first(workflows),
            "prTemplates": _shortest_first(templates), "docsDirs": _shortest_first(docs_dirs)}


def _first_table(facts: Dict[str, Any], code: List[str]) -> Tuple[str, str]:
    """The first table of LOOM_SPEC.md 9.13.1: (fast | onboarding, reason)."""
    ref = facts.get("mainRef")
    files = facts.get("mainFiles") or []
    if not ref:
        return "fast", "the repository has no commits"
    if code:
        return "onboarding", "%s tracks %s that count%s as code (first: %s)" % (
            ref, _plural(len(code), "file", "files"), "s" if len(code) == 1 else "", code[0])
    if not files:
        return "fast", "%s tracks no files" % ref
    return "fast", "%s tracks only files that are not code (%s)" % (ref, _plural(len(files), "file", "files"))


def setup_path(facts: Dict[str, Any]) -> Dict[str, Any]:
    """The setup path from git facts (LOOM_SPEC.md 8.2, 9.13.1). Pure function.

    facts (every key optional):
      branch: the current branch, or None;
      localSetupBranches: the local branches chore/<n>-loom-setup;
      originSetupBranches: the branches chore/<n>-loom-setup on origin
        (remote-tracking refs, no network call);
      mainRef: the main ref (`origin/<main>`, else `<main>`), or None when
        the repository has no commits;
      mainFiles: the files that mainRef tracks;
      ticketFound: the active <task dir>/00-ticket.md exists;
      ticketMode: the ticket's mode (oneshot, quick, full), or None when the
        ticket is missing or has no valid mode;
      branchSubjects: the commit subjects of `<mainRef>..HEAD`;
      noOwnCommits: HEAD has no commit of its own (it is an ancestor of
        origin/<main> or of the local <main>), or the repository has no commits;
      configInWorkingTree: .claude/loom.json exists in the working tree.
    Returns {path, reason, setupBranches, codeFiles, found}. The first
    matching row of the path table wins.
    """
    branch = facts.get("branch") or ""
    local = list(facts.get("localSetupBranches") or [])
    origin_only = [b for b in facts.get("originSetupBranches") or [] if b not in local]
    setup_branches = sorted(local + origin_only, key=_setup_branch_key)
    ref = facts.get("mainRef")
    files = list(facts.get("mainFiles") or []) if ref else []
    code = [path for path in files if is_code_file(path)]
    has_config = CONFIG_FILE in files
    m = SETUP_BRANCH_RE.match(branch)
    if not m:
        # Rows 1-3: not on a setup branch. A setup branch only on origin is a
        # stale remote-tracking ref once the main ref has loom.json.
        switch = sorted(local + ([] if has_config else origin_only), key=_setup_branch_key)
        if switch:
            path = "switch"
            reason = "the setup branch %s exists" % switch[0] if len(switch) == 1 else \
                "the setup branches %s exist" % ", ".join(switch)
        elif has_config:
            path = "rerun"
            reason = "%s has %s: loom is set up" % (ref, CONFIG_FILE)
        else:
            path, reason = _first_table(facts, code)
    else:
        # Rows 4-7: on a setup branch.
        number = int(m.group(1))
        kickoff = KICKOFF_SUBJECT % number
        subjects = facts.get("branchSubjects") or []
        mode = facts.get("ticketMode")
        if mode == "full" and FAST_SETUP_SUBJECT % number not in subjects:
            path = "onboarding-rerun"
            reason = "%s: the ticket has mode full" % branch
        elif kickoff in subjects:
            path = "onboarding-rerun"
            if not facts.get("ticketFound"):
                state = "is missing"
            elif mode:
                state = "has mode %s" % mode
            else:
                state = "has no valid mode"
            reason = "%s: the ticket %s, and the branch has the kickoff commit '%s'" % (branch, state, kickoff)
        elif facts.get("noOwnCommits") and not facts.get("configInWorkingTree"):
            path, first = _first_table(facts, code)
            reason = "%s has no commit of its own and no %s (setup stopped after git switch -c); %s" % (
                branch, CONFIG_FILE, first)
        else:
            parts = []
            if not facts.get("noOwnCommits"):
                parts.append("commits of its own")
            if facts.get("configInWorkingTree"):
                parts.append("%s in the working tree" % CONFIG_FILE)
            reason = "%s: a stopped fast setup (%s)" % (branch, ", ".join(parts))
            path = "fast-resume"
    return {"path": path, "reason": reason, "setupBranches": setup_branches, "codeFiles": len(code),
            "found": found_paths(files)}


def _setup_branch_key(name: str) -> Tuple[int, str]:
    m = SETUP_BRANCH_RE.match(name)
    return (int(m.group(1)) if m else 0, name)


def _git_list(args: List[str], top: str, sep: str = "\n") -> List[str]:
    """Output items of a git command; `-z` output keeps empty items (an empty commit subject)."""
    rc, out, err = git(args, top)
    if rc != 0:
        raise SetupPathError("git %s failed: %s" % (args[0], (err.strip().splitlines() or ["?"])[0]))
    if sep == "\0":
        items = out.split("\0")
        return items[:-1] if items and items[-1] == "" else items
    return [line for line in out.splitlines() if line]


def _commit_of(top: str, ref: str) -> Optional[str]:
    return git_out(["rev-parse", "--verify", "--quiet", ref + "^{commit}"], top) or None


def _is_ancestor(top: str, commit: str, tip: str) -> bool:
    """`git merge-base --is-ancestor commit tip` (a commit is its own ancestor)."""
    rc, _, err = git(["merge-base", "--is-ancestor", commit, tip], top)
    if rc not in (0, 1):
        raise SetupPathError("git merge-base failed: %s" % (err.strip().splitlines() or ["?"])[0])
    return rc == 0


def setup_facts(top: str, main_branch: str) -> Dict[str, Any]:
    """Collect the git facts of setup_path() for the repository at top. No network call.

    Raises SetupPathError when a git command fails, and when the repository
    has commits but main_branch exists neither locally nor on origin.
    """
    branch, _ = task_branch(top)
    local: List[str] = []
    origin: List[str] = []
    refs = _git_list(["for-each-ref", "--format=%(refname)", "refs/heads/chore/", "refs/remotes/origin/chore/"],
                     top)
    for full in refs:
        for prefix, names in (("refs/heads/", local), ("refs/remotes/origin/", origin)):
            name = full[len(prefix):] if full.startswith(prefix) else ""
            if SETUP_BRANCH_RE.match(name) and name not in names:
                names.append(name)
    origin_tip = _commit_of(top, "refs/remotes/origin/%s" % main_branch)
    local_tip = _commit_of(top, "refs/heads/%s" % main_branch)
    head = _commit_of(top, "HEAD")
    files: List[str] = []
    ref = None
    if origin_tip or local_tip:
        ref = "origin/%s" % main_branch if origin_tip else main_branch
        files = _git_list(["ls-tree", "-r", "-z", "--name-only", origin_tip or local_tip or ""], top, sep="\0")
    elif head or _git_list(["rev-list", "-n", "1", "--all"], top):
        raise SetupPathError("the main branch '%s' exists neither locally nor on origin" % main_branch)
    facts: Dict[str, Any] = {
        "branch": branch,
        "localSetupBranches": local,
        "originSetupBranches": origin,
        "mainRef": ref,
        "mainFiles": files,
        "ticketFound": False,
        "ticketMode": None,
        "branchSubjects": [],
        "noOwnCommits": head is None or any(_is_ancestor(top, head, tip)
                                            for tip in (origin_tip, local_tip) if tip),
        "configInWorkingTree": os.path.isfile(config_path(top)),
    }
    m = SETUP_BRANCH_RE.match(branch or "")
    if not m:
        return facts
    # Only the active task directory: an archived setup task does not count.
    cfg, _ = load_config(top)
    work_dir = os.path.normpath(os.path.join(top, (cfg or DEFAULT_CONFIG)["workDir"]))
    number = int(m.group(1))
    names = _task_dirs(work_dir, number)
    exact = "%d-%s" % (number, SETUP_SLUG)
    chosen = exact if exact in names else (names[0] if names else None)
    text = read_text(os.path.join(work_dir, chosen, TICKET_FILE)) if chosen else None
    if text is not None:
        facts["ticketFound"] = True
        mode = normalize_mode(parse_frontmatter(text).get("mode"))
        facts["ticketMode"] = mode if mode in MODES else None
    if head and ref:
        facts["branchSubjects"] = _git_list(["log", "-z", "--format=%s", "%s..HEAD" % (origin_tip or local_tip)],
                                            top, sep="\0")
    return facts


def print_setup_path(cwd: str, main_branch: str) -> int:
    """`--setup-path <main>`: print the setup path as one JSON object (LOOM_SPEC.md 8.2).

    Works without .claude/loom.json. Exits 2 outside a git repository and for
    a main branch name that git does not accept; 1 when a git command fails or
    the main branch is missing in a repository with commits.
    """
    top = find_toplevel(cwd)
    if not top:
        sys.stderr.write("loom-state: --setup-path needs a git repository\n")
        return 2
    name = main_branch.strip()
    if not name or _has_control(name) or git(["check-ref-format", "refs/heads/" + name], top)[0] != 0:
        sys.stderr.write("loom-state: --setup-path: invalid main branch name %s\n"
                         % json.dumps(main_branch, ensure_ascii=False))
        return 2
    try:
        facts = setup_facts(top, name)
    except SetupPathError as exc:
        sys.stderr.write("loom-state: --setup-path: %s\n" % exc)
        return 1
    sys.stdout.write(json.dumps(setup_path(facts), indent=2, ensure_ascii=False) + "\n")
    return 0


def _utf8_output() -> None:
    """Print UTF-8 (`·`, non-ASCII titles) under any locale; escape what cannot be encoded."""
    for stream in (sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if reconfigure is None:
            continue
        try:
            reconfigure(encoding="utf-8", errors="backslashreplace")
        except (ValueError, OSError):
            pass


def main(argv: Optional[List[str]] = None) -> int:
    _utf8_output()
    args_in = sys.argv[1:] if argv is None else argv
    if len(args_in) == 2 and args_in[0] == "--slug":
        # Before argparse: a title that starts with `-` would look like an option.
        sys.stdout.write(slugify(args_in[1]) + "\n")
        return 0

    parser = argparse.ArgumentParser(prog="loom-state", description="Compute the loom task state.")
    fmt = parser.add_mutually_exclusive_group()
    fmt.add_argument("--json", action="store_true", help="JSON output (default)")
    fmt.add_argument("--line", action="store_true", help="one line for the statusline")
    fmt.add_argument("--slug", metavar="TITLE", help="print the branch slug for an issue title and exit")
    fmt.add_argument("--setup-path", metavar="MAIN",
                     help="print the setup path for /loom:setup as JSON and exit (no .claude/loom.json needed)")
    parser.add_argument("--pr", action="store_true", help="add pull request state (calls gh and the network)")
    parser.add_argument("--docs", action="store_true", help="docs freshness check (reserved)")
    args = parser.parse_args(args_in)
    if args.setup_path is not None and (args.pr or args.docs):
        # --setup-path makes no network call and has no docs check (exit 2, like the group above).
        parser.error("argument --setup-path: not allowed with argument %s" % ("--pr" if args.pr else "--docs"))

    if args.slug is not None:
        # Pure string function: works anywhere, also outside a loom project.
        sys.stdout.write(slugify(args.slug) + "\n")
        return 0

    cwd = os.getcwd()
    if args.setup_path is not None:
        return print_setup_path(cwd, args.setup_path)
    top = find_toplevel(cwd)
    if not top or not os.path.isfile(config_path(top)):
        return 0  # not a loom project: silent no-op
    if args.docs:
        sys.stderr.write("loom-state: --docs is not implemented yet (planned for v1.2)\n")
        return 2
    state = compute_state(cwd, with_pr=args.pr, for_line=args.line)
    if state is None:
        return 0
    if args.line:
        line = format_line(state)
        if line:
            sys.stdout.write(line + "\n")
        return 0
    sys.stdout.write(json.dumps(state, indent=2, ensure_ascii=False) + "\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except Exception as exc:  # never show a traceback in the statusline
        sys.stderr.write("loom-state: unexpected error: %s\n" % exc)
        sys.exit(1)
